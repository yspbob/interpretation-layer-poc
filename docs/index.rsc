1:[["$","a",null,{"className":"skip-link","href":"#main","children":"Skip to content"}],["$","header",null,{"className":"masthead","children":["$","div",null,{"className":"masthead-inner","children":[["$","a",null,{"className":"brand","href":"/interpretation-layer-poc/","children":[["$","span",null,{"className":"brand-mark","children":["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z","key":"zw3jo"}],["path",{"d":"M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12","key":"1wduqc"}],["path",{"d":"M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17","key":"kqbvx6"}]],"className":"lucide-layers","size":22}]}],["$","span",null,{"children":[["$","strong",null,{"children":"Interpretation layer"}],["$","small",null,{"children":"AI ENGINEERING PLAYBOOK"}]]}]]}],["$","a",null,{"className":"chapter-link","href":"https://yspbob.github.io/AI-Playbook/AI_Engineering_Playbook.html#4-the-interpretation-layer","target":"_blank","rel":"noreferrer","children":["Chapter 4 ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}]}],["$","div",null,{"className":"nav-bar","children":["$","div",null,{"className":"nav-inner","children":[["$","nav",null,{"aria-label":"Main sections","children":[["$","a",null,{"aria-current":"page","href":"/interpretation-layer-poc/","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 5v16","key":"1f6ucr"}],["path",{"d":"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":17}],"The experiment"]}],["$","a",null,{"aria-current":"$undefined","href":"/interpretation-layer-poc/progress/","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2","key":"169zse"}]],"className":"lucide-activity","size":17}],"Progress & findings"]}]]}],["$","span",null,{"className":"study-id","children":"IL / POC — 001"}]]}]}],["$","main",null,{"id":"main","className":"workspace","children":[["$","div",null,{"className":"page-heading","children":[["$","span",null,{"className":"eyebrow","children":"AI ENGINEERING PLAYBOOK / CHAPTER 4"}],["$","span",null,{"className":"reading-time","children":"Why we are running this experiment"}]]}],["$","section",null,{"className":"intro","children":[["$","div",null,{"children":[["$","h1",null,{"children":"Will an interpretation layer help an AI agent make better code changes?"}],["$","p",null,{"className":"lead","children":"An AI agent can read a project’s code and documentation. But it still has to decide which existing patterns to follow, which exceptions matter, and what it should leave alone."}],["$","p",null,{"className":"intro-explanation","children":["The playbook proposes an ",["$","strong",null,{"children":"interpretation layer"}]," that turns this evidence into approved guidance, helps agents check a proposed change against it, and supports checks on the resulting work. This experiment asks which parts of that process help, and whether the improvement justifies the effort."]}],["$","p",null,{"className":"chapter-context","children":["The full proposal is in ",["$","a",null,{"href":"https://yspbob.github.io/AI-Playbook/AI_Engineering_Playbook.html#4-the-interpretation-layer","target":"_blank","rel":"noreferrer","children":"Chapter 4: The interpretation layer"}]," of the public AI Engineering Playbook."]}],["$","a",null,{"className":"text-link intro-jump","href":"#example","children":["What the layer provides ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 5v14","key":"s699le"}],["path",{"d":"m19 12-7 7-7-7","key":"1idqje"}]],"className":"lucide-arrow-down","size":16}]]}]]}],["$","aside",null,{"className":"hypothesis","children":[["$","span",null,{"className":"eyebrow","children":"WHY TEST THIS?"}],["$","p",null,{"children":"Does preparing the guidance help? Does checking the agent’s work against it add a further benefit?"}],"$Le","$Lf"]}]]}],"$L10","$L11","$L12","$L13","$L14"]}],"$L15"]
