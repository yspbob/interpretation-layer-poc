$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2","key":"169zse"}]],"className":"lucide-activity","size":17}],"Progress & findings"]}]]}],["$","span",null,{"className":"study-id","children":"IL / POC — 001"}]]}]}],["$","main",null,{"id":"main","className":"workspace","children":[["$","div",null,{"className":"page-heading","children":[["$","span",null,{"className":"eyebrow","children":"AI ENGINEERING PLAYBOOK / CHAPTER 4"}],["$","span",null,{"className":"reading-time","children":"Why this experiment is being run"}]]}],["$","section",null,{"className":"intro","children":[["$","div",null,{"children":[["$","h1",null,{"children":"Will an interpretation layer help an AI agent make better code changes?"}],["$","p",null,{"className":"lead","children":"An AI agent can read a project’s code and documentation. But it still has to decide which existing patterns to follow, which exceptions matter, and what it should leave alone."}],["$","p",null,{"className":"intro-explanation","children":["The playbook proposes an ",["$","strong",null,{"children":"interpretation layer"}]," that turns this evidence into approved guidance, helps agents check a proposed change against it, and supports checks on the resulting work. This experiment asks which parts of that process help, and whether the improvement justifies the effort."]}],["$","p",null,{"className":"chapter-context","children":["The full proposal is in ",["$","a",null,{"href":"https://yspbob.github.io/AI-Playbook/AI_Engineering_Playbook.html#4-the-interpretation-layer","target":"_blank","rel":"noreferrer","children":"Chapter 4: The interpretation layer"}]," of the public AI Engineering Playbook."]}],["$","div",null,{"className":"experiment-jumps","children":[["$","a",null,{"className":"text-link intro-jump","href":"#example","children":["What the layer provides ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 5v14","key":"s699le"}],["path",{"d":"m19 12-7 7-7-7","key":"1idqje"}]],"className":"lucide-arrow-down","size":16}]]}],["$","a",null,{"className":"text-link intro-jump","href":"#technical-setup","children":["Technical setup ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1:3:props:children:1:props:children:0:props:children:4:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-down","size":16}]]}]]}]]}],["$","aside",null,{"className":"hypothesis","children":["$Le","$Lf","$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15","$L16","$L17"]}],"$L18"]
