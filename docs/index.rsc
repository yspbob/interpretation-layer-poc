1:[["$","a",null,{"className":"skip-link","href":"#main","children":"Skip to content"}],["$","header",null,{"className":"masthead","children":["$","div",null,{"className":"masthead-inner","children":[["$","a",null,{"className":"brand","href":"/interpretation-layer-poc/","children":[["$","span",null,{"className":"brand-mark","children":["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z","key":"zw3jo"}],["path",{"d":"M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12","key":"1wduqc"}],["path",{"d":"M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17","key":"kqbvx6"}]],"className":"lucide-layers","size":22}]}],["$","span",null,{"children":[["$","strong",null,{"children":"Interpretation layer"}],["$","small",null,{"children":"AI ENGINEERING PLAYBOOK"}]]}]]}],["$","a",null,{"className":"chapter-link","href":"https://yspbob.github.io/AI-Playbook/AI_Engineering_Playbook.html#4-the-interpretation-layer","target":"_blank","rel":"noreferrer","children":["Chapter 4 ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}]}],["$","div",null,{"className":"nav-bar","children":["$","div",null,{"className":"nav-inner","children":[["$","nav",null,{"aria-label":"Current phase views","children":[["$","a",null,{"aria-current":"page","href":"/interpretation-layer-poc/","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 5v16","key":"1f6ucr"}],["path",{"d":"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":17}],"The plan"]}],["$","a",null,{"aria-current":"$undefined","href":"/interpretation-layer-poc/progress/","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2","key":"169zse"}]],"className":"lucide-activity","size":17}],"Progress & findings"]}]]}],["$","a",null,{"className":"roadmap-link","href":"/interpretation-layer-poc/#how-phases-fit","children":"How the phases fit together"}]]}]}],["$","main",null,{"id":"main","className":"workspace","children":[["$","header",null,{"className":"plan-opening","children":[["$","span",null,{"className":"eyebrow","children":"AI ENGINEERING PLAYBOOK / THE FIRST TRIAL"}],["$","h1",null,{"children":"Does understanding the project’s rules help an agent make better changes?"}],["$","p",null,{"className":"lead","children":"An AI agent can read code and follow instructions. The playbook proposes an interpretation layer that turns evidence about a project into guidance, then helps the agent apply it during work. This POC tests whether those added steps are useful."}],["$","p",null,{"children":["The proposal comes from ",["$","a",null,{"className":"text-link","href":"https://yspbob.github.io/AI-Playbook/AI_Engineering_Playbook.html#4-the-interpretation-layer","target":"_blank","rel":"noreferrer","children":"Chapter 4 of the AI Engineering Playbook"}],". We will start with one public project and a small set of different decisions, so we can inspect the results before building a wider study."]}]]}],["$","section",null,{"className":"connected-story","id":"how-phases-fit","aria-labelledby":"how-phases-fit-title","children":[["$","span",null,{"className":"eyebrow","children":"ONE EXPERIMENT, BUILT IN STAGES"}],["$","h2",null,{"id":"how-phases-fit-title","children":"How the three phases fit together"}],["$","p",null,{"children":"We will build and test the layer in three stages. First we examine its guidance. Then we test whether that guidance helps with coding. Finally, we test whether asking questions and checking decisions during work makes a further difference."}],["$","div",null,{"className":"story-step","children":[["$","span",null,{"aria-hidden":"true","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"First, find out what guidance the layer produces."}],"$Le","$Lf"]}]]}],"$L10","$L11","$L12","$L13"]}],"$L14"]}],"$L15"]
16:I["df0b54c1d243",[],"PhasePlans",1]
17:I["1c4abca9d553",[],"DetailGroup",1]
18:I["1c4abca9d553",[],"Disclosure",1]
e:["$","p",null,{"children":["Give an agent a defined set of project evidence and ask it to propose rules. That agent is the ",["$","strong",null,{"children":"drafter"}],". A separate ",["$","strong",null,{"children":"verifier"}]," checks whether its claims are supported. An independent assessment then examines the guide and the verifier’s decisions, including mistakes, missing rules and valid exceptions."]}]
f:["$","p",null,{"children":"We learn which rules the layer recovered, what it missed and where it made mistakes. We have not yet tested whether anyone benefits from using the guide."}]
10:["$","div",null,{"className":"story-step","children":[["$","span",null,{"aria-hidden":"true","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Then, test whether the guide helps with coding."}],["$","p",null,{"children":"Ask agents to make the same historical changes. One group works from the project sources alone; another receives the same sources plus the guide. Both get ordinary reviews under the same rules. We independently assess their code and compare the full cost, including preparing the guide."}],["$","p",null,{"children":"Preparation failures count too. We keep the guide the verifier produced, even if it is empty, so the comparison does not hide the times preparation failed."}]]}]]}]
11:["$","div",null,{"className":"story-step","children":[["$","span",null,{"aria-hidden":"true","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Finally, test consultation and checking during work."}],["$","p",null,{"children":["Add a third group that can consult the layer while it works. A ",["$","strong",null,{"children":"checker"}]," can ask the agent to explain how its next action respects the guidance and require a correction when necessary. Run all three groups together, with the same review rules and spending limits."]}],["$","p",null,{"children":"This tests whether interaction helps beyond a fixed guide and ordinary review. We also assess the checker, including cases where it misses a problem or interrupts valid work."}]]}]]}]
12:["$","p",null,{"className":"story-conclusion","children":"After each phase, we can continue, improve the method or stop. A negative result is useful too. The trial can show whether the layer helps in the situations we tested. It cannot establish that every project needs it."}]
13:["$","p",null,{"className":"story-limits","children":"There is no project owner available to approve new rules, and a model may already know the public code. We will report those limits. A separate study on fresh cases, or work on production approval and maintenance, would need its own decision after this trial."}]
14:["$","$L16",null,{"guidance":[["$","header",null,{"className":"selected-phase-intro","children":[["$","span",null,{"className":"eyebrow","children":"PHASE 1 / OUR CURRENT FOCUS"}],["$","h2",null,{"children":"Reconstruct guidance"}],["$","p",null,{"children":"This is where we start. We will choose the evidence, ask the layer to prepare guidance and check what it got right or wrong."}]]}],["$","section",null,{"className":"section-block","id":"guidance-method","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-no","children":"01"}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"THE WORK IN THIS PHASE"}],["$","h2",null,{"children":"From project evidence to an assessed guide"}]]}]]}],["$","ol",null,{"className":"method-steps","children":[["$","li",null,{"className":"method-step","children":[["$","div",null,{"className":"method-step-heading","children":[["$","span",null,{"className":"method-step-number","children":"1"}],["$","h3",null,{"children":"Choose the evidence and establish what it supports"}]]}],["$","div",null,{"className":"method-step-content","children":[["$","p",null,{"children":"Choose one project and a small set of rules to investigate. Establish what the project’s records and code tell us about each rule. Record exceptions and anything we cannot settle."}],["$","p",null,{"children":"Prepare separate files for the layer and for assessment. The drafter and verifier receive the project files chosen for the test. They cannot read the separate record used to assess their answers."}],["$","$L17",null,{"children":["$","$L18",null,{"id":"source-access","title":"What can the layer read?","children":[["$","p",null,{"children":"Use a fixed code version and the project instructions that actually applied to it. Record every supplied file and the reason it belongs in the input. Do not select files to hint at a hidden answer."}],["$","p",null,{"children":"Some cases will expose a rule in documentation; others may require interpreting code. Record that distinction for each claim. Never remove applicable project instructions to manufacture an inference test."}],["$","p",null,{"children":"If the evidence cannot establish a central requirement, leave that case out of scored assessment. Record it as unresolved."}]]}]}]]}]]}],["$","li",null,{"className":"method-step","children":[["$","div",null,{"className":"method-step-heading","children":[["$","span",null,{"className":"method-step-number","children":"2"}],["$","h3",null,{"children":"Ask the drafter to prepare guidance"}]]}],["$","div",null,{"className":"method-step-content","children":[["$","p",null,{"children":"The drafter is the part of the interpretation layer that proposes rules. It explains what each rule means, where it applies, what supports it and where an exception or uncertainty remains."}],["$","p",null,{"children":"It does not receive a later coding task or the assessment answers. We keep its original draft so that mistakes remain visible even if they are corrected later."}]]}]]}],["$","li",null,{"className":"method-step","children":[["$","div",null,{"className":"method-step-heading","children":[["$","span",null,{"className":"method-step-number","children":"3"}],["$","h3",null,{"children":"Check the draft against its evidence"}]]}],["$","div",null,{"className":"method-step-content","children":[["$","p",null,{"children":"A separate verifier checks the drafter’s claims. It can accept a supported claim, request a correction or leave it unresolved. We decide in advance how many corrections it can request and how much preparation can cost."}],["$","p",null,{"children":"Save both the draft and the accepted guide, together with the verifier’s decisions. Acceptance means that the verifier found evidence support. It is not approval from a project owner."}]]}]]}],["$","li",null,{"className":"method-step","children":[["$","div",null,{"className":"method-step-heading","children":[["$","span",null,{"className":"method-step-number","children":"4"}],"$L19"]}],"$L1a"]}]]}]]}],"$L1b","$L1c"],"use":"$L1d","interaction":"$L1e","reference":"$L1f"}]
15:["$","footer",null,{"className":"site-footer","children":[["$","span",null,{"children":"AI Engineering Playbook · Interpretation layer validation"}],["$","span",null,{"children":"Research in progress · Updated as the study develops"}]]}]
2f:I["1c4abca9d553",[],"Examples",1]
19:["$","h3",null,{"children":"Assess the guidance independently"}]
1a:["$","div",null,{"className":"method-step-content","children":[["$","p",null,{"children":"A separate assessment uses the hidden reference evidence to examine the draft, the accepted guide and the verifier’s decisions. The verifier cannot judge its own success."}],["$","p",null,{"children":"Check what the guide got right, what it missed and what it asserted without support. Also check whether the verifier accepted a bad claim or rejected a valid one. Record preparation time, cost and failed attempts."}],["$","$L17",null,{"children":["$","$L18",null,{"id":"guidance-assessment","title":"How will we know that the assessment is reliable?","children":[["$","p",null,{"children":"Build examples containing supported rules, plausible mistakes, legitimate alternatives and statements the evidence cannot settle. Explain the expected assessment from the sources and behaviour, rather than taking another model’s agreement as proof."}],["$","p",null,{"children":"Test any model used to verify or assess guidance on separate examples before using its scores. Fix the criteria, error limits and required coverage in advance. Examples used to repair the assessment remain development material."}],["$","p",null,{"children":"For each case, write down which rules the evidence supports, which alternative answers are valid and what counts as a serious mistake. Check for missing rules as well as incorrect ones. An empty guide has no false claims, but it has not recovered any rules either."}],["$","p",null,{"children":"We can measure coverage of the decisions we examined. We cannot claim to have checked every important rule in the project. These case records and pass criteria still need to be completed."}]]}]}]]}]
1b:["$","section",null,{"className":"phase-scope","id":"phase-deliverable","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"WHAT WE WILL HAVE"}],["$","h2",null,{"children":"A result we can examine before building more."}],["$","p",null,{"children":"We will save the guide and its original draft, with the evidence for each claim. The report will explain the verifier’s decisions, the mistakes and omissions found by independent assessment, and what preparation cost."}]]}],["$","div",null,{"children":[["$","h3",null,{"children":"The decision at the end"}],["$","p",null,{"children":"Decide whether to continue to coding tasks, improve the preparation method or stop. A poor result can justify stopping the study."}],["$","p",null,{"children":"If we continue, we will not select only the guides that scored well. Each preparation attempt in the comparison keeps its result and cost, including an empty guide. A repaired method needs a separately recorded version and fresh preparation where required."}],["$","p",null,{"children":"This phase can establish the quality of the guidance in the tested cases. It cannot show that the guidance improves code or pays for itself."}]]}]]}]
1c:["$","section",null,{"className":"section-block","id":"phase-controls","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-no","children":"02"}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"KEEPING THE TEST CREDIBLE"}],["$","h2",null,{"children":"Build the controls this phase actually uses"}]]}]]}],["$","p",null,{"className":"section-intro","children":"Each agent starts in a separate conversation and receives only the files assigned to it. The system must prevent the drafter and verifier from opening the assessment answers. We also record exactly what each agent received."}],["$","$L17",null,{"children":[["$","$L18",null,{"id":"phase-technology","title":"What needs to be built now, and what can wait?","children":[["$","p",null,{"children":"First, build a way to give each agent its assigned files, limit its work and save its decisions and costs. Keep the assessment answers separate and inaccessible. Any tool exposed to a role must pass the relevant boundary tests before use."}],["$","p",null,{"children":"Start with controlled reading of supplied files. Coding agents, automated code review and the interactive checker belong to later phases. We do not need to implement them to assess a guide."}],["$","p",null,{"children":"If an agent is allowed to execute code to inspect a source, that capability needs the full execution restrictions and testing before it is enabled. Deferring coding tasks does not waive containment for tools we actually expose."}],["$","p",null,{"children":["$","a",null,{"className":"text-link","href":"/interpretation-layer-poc/#technical-setup","children":"Read the proposed setup for the complete trial."}]}]]}],["$","$L18",null,{"id":"guidance-task-selection","title":"When do we choose the later coding tasks?","children":[["$","p",null,{"children":"If a guide will be used in Phase 2, choose its intended tasks before preparing it. Check that the guide’s sources belong to the code versions those tasks use. A guide based on a later version could reveal information that was unavailable at the time."}],["$","p",null,{"children":"The investigator selects the tasks. The drafter and verifier do not see them or their solutions. We must not look at a finished guide and then choose only changes it happens to help."}]]}],["$","$L18",null,{"id":"familiarity","title":"Could the model already know the public project?","children":[["$","p",null,{"children":"Yes. A model may recognise public code from before our study. The checks below look for signs of that knowledge. They cannot prove that the code was unfamiliar."}],[["$","h3",null,{"children":"What the agent learns during our study"}],["$","p",null,{"children":"An agent is meant to read the code assigned to its task. It can remember that evidence while it works. What it must not inherit is another attempt’s history, our research notes or the hidden answers."}],["$","p",null,{"children":"Each independent attempt starts with a fresh conversation and workspace. Only its assigned inputs are carried in, including the prepared guide for groups that receive one. The drafter’s conversation and assessment feedback stay out."}],["$","p",null,{"children":"Calling a session incognito would not prove that separation. We must check the actual history, files, memory and tool access. These controls are required but have not yet been implemented or tested."}],["$","p",null,{"children":"Provider training and storage settings need a separate check when we choose the experimental interface. A fresh session cannot erase knowledge already learned during model training."}],["$","h3",null,{"children":"What the model may have known beforehand"}],"$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]]}],"$L29","$L2a","$L2b"]}]]}]
1d:[["$","header",null,{"className":"selected-phase-intro","children":[["$","span",null,{"className":"eyebrow","children":"PHASE 2 / AFTER ASSESSING THE GUIDANCE"}],["$","h2",null,{"children":"Test the guidance in use"}],["$","p",null,{"children":"A sound guide may still be unhelpful during a real change. This phase asks whether an agent does better when it receives the guide."}]]}],["$","section",null,{"className":"phase-procedure","children":[["$","h3",null,{"children":"What we start with"}],["$","p",null,{"children":"Use the guide produced by the verifier for each preparation attempt in the comparison. It contains only claims the verifier accepted. If no claims were accepted, use the empty guide and keep its preparation cost."}],["$","p",null,{"children":"We do not select only guides that scored well in the independent assessment. Keeping poor outcomes lets us test the reliability of the whole preparation method."}],["$","p",null,{"children":"The tasks come from the same project’s history. Choose them before preparing their guide, check that its sources match their code versions, and establish how to assess each result. Keep the tasks and historical solutions hidden from the drafter and verifier."}],["$","h3",null,{"children":"What the agents do"}],["$","p",null,{"children":["Ask two groups to make the same changes. ",["$","strong",null,{"children":"Sources only"}]," receives the permitted project files. ",["$","strong",null,{"children":"Sources and prepared guidance"}]," receives those files and the fixed guide."]}],["$","p",null,{"children":"Both groups plan, implement and review their work. Both receive the same rules for review checkpoints and corrections, including another check when their plan changes. This phase does not add the interactive layer."}],["$","h3",null,{"children":"How we assess the result"}],["$","p",null,{"children":"An independent assessment checks whether each change fulfils its task and respects the applicable project rules. The historical implementation is assessed too; it may contain a mistake, so copying it is not automatically success."}],["$","p",null,{"children":"Compare quality, failures and total cost. Preparation counts as part of the guidance method’s cost. All attempts remain in the record, including unfinished work and exhausted budgets."}],["$","h3",null,{"children":"What this phase produces"}],["$","p",null,{"children":"A comparison showing where the guide helped, where it did not and what using it cost. That gives us a basis for deciding whether to test interaction, repair the method or stop."}]]}],["$","$L17",null,{"children":[["$","$L18",null,{"id":"use-fairness","title":"How do we keep the comparison fair?","children":[["$","p",null,{"children":"Use matched tasks, code versions, coding models, source access and ordinary review settings. Give each method the same total allowance. Preparing the guide uses part of the guidance method’s allowance."}],["$","p",null,{"children":"Before preparing a guide, record which tasks will use it and check that it applies to their code versions. Share the preparation cost across those tasks. If a task fails, keep its share of the cost in the results."}],["$","p",null,{"children":"If hidden assessment feedback helped repair a guide, record that history. The repaired material can help develop the method, but cannot also provide independent evidence that the original method worked."}],["$","p",null,{"children":"The code execution environment and its access boundaries must be tested before use. Before the assessor scores the experiment, test it on other cases with well supported expected answers. Check whether it recognises both valid solutions and plausible mistakes."}]]}],"$L2c","$L2d"]}],"$L2e"]
1e:[["$","header",null,{"className":"selected-phase-intro","children":[["$","span",null,{"className":"eyebrow","children":"PHASE 3 / AFTER TESTING THE GUIDE IN USE"}],["$","h2",null,{"children":"Test interaction during work"}],["$","p",null,{"children":"This phase tests the part of the layer that helps an agent apply the guidance while a change is taking shape."}]]}],["$","section",null,{"className":"phase-procedure","children":[["$","h3",null,{"children":"What we start with"}],["$","p",null,{"children":"Use the established guidance and coding comparison, then add a checker. The checker is the role that asks whether a proposed action respects the rules and whether an exception is justified."}],["$","h3",null,{"children":"What the agents do"}],["$","p",null,{"children":["Run all three groups together: ",["$","strong",null,{"children":"Sources only"}],"; ",["$","strong",null,{"children":"Sources and prepared guidance"}],"; and ",["$","strong",null,{"children":"Sources, prepared guidance and interaction"}],"."]}],["$","p",null,{"children":"The third group can consult the layer about its approach. At required checkpoints, the checker can ask the agent to explain its choices. It can require a correction or stop work when a necessary decision remains unresolved."}],["$","p",null,{"children":"All groups still receive ordinary reviews under matched rules. The interactive group does not simply receive an extra review or a larger budget."}],["$","h3",null,{"children":"How we assess the result"}],["$","p",null,{"children":"Assess the resulting code independently, as in Phase 2. Also examine the checker’s interventions: did they catch a real problem, miss one or unnecessarily obstruct valid work?"}],["$","p",null,{"children":"Run the first two groups again alongside the interactive group. If we used their old Phase 2 scores, a change in the model or procedure could be mistaken for a benefit of interaction."}],["$","h3",null,{"children":"What this phase produces"}],["$","p",null,{"children":"A report on the additional benefit, failures and cost of interaction. Together, the three phases tell us whether the layer can construct defensible guidance, whether that guidance helps and whether checking its use adds further value."}]]}],["$","$L17",null,{"children":[["$","$L18",null,{"id":"interaction-checks","title":"What happens when the agent changes its plan?","children":[["$","p",null,{"children":"The agent must submit an updated plan when a change affects the decisions it relies on. Defined checkpoints and detected changes trigger review, and required checks pause further work until a decision is recorded."}],["$","p",null,{"children":"All groups have the same review trigger policy and correction limits. The interactive group adds questions grounded in the guide. We must test the actual detection and pause controls; this is not a claim of continuous monitoring of every action."}]]}],["$","$L18",null,{"id":"interaction-assessment","title":"How will the checker itself be assessed?","children":[["$","p",null,{"children":"Before using them in the experiment, test the checker and the separate agent that assesses its decisions. Use other cases where the evidence supports the expected answer. Include real violations, legitimate exceptions, unnecessary objections and cases where the available evidence cannot settle the question."}],["$","p",null,{"children":"Retain questions, answers, revisions, stops and costs. The checker cannot judge its own success, and hidden assessment feedback does not return to working agents."}]]}]]}],["$","p",null,{"className":"phase-handoff","children":"The first trial ends with its evidence and limitations. Confirmation on fresh cases would be a separate decision, not an automatic claim that the layer works everywhere."}]]
1f:[["$","section",null,{"id":"example","className":"section-block","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-no","children":"01"}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"GUIDANCE FOR A SPECIFIC TASK"}],["$","h2",null,{"children":"What would the layer tell an agent?"}]]}]]}],["$","p",null,{"className":"section-intro","children":"For a proposed change, the layer should explain which existing code can be reused and which project rules apply. Its answer should show the evidence and any valid exceptions. It must distinguish an approved decision from a pattern observed in code or a question still awaiting review."}],["$","p",null,{"className":"section-intro","children":"In the interactive phase, an agent can ask about its approach before proceeding. If the evidence cannot settle a decision needed for the task, the attempt stops. Production would involve an owner; this POC has no owner to supply that answer."}],["$","$L17",null,{"children":["$","$L18",null,{"id":"guidance-examples","title":"See examples of the guidance an agent could receive","summary":"How this applies to change history, conflicting documentation and questions the code cannot answer.","children":[["$","p",null,{"children":"NetBox is an application with public source code used to document network infrastructure, including devices and their connections. It is one of the four candidate projects we screened. The trial repository has not been chosen."}],["$","p",null,{"children":"In the first example, an agent is asked to write code that renames a device in NetBox. The layer would draw its attention to a related requirement: the change history must preserve the old name as well as the new one. It would also explain when NetBox already handles that requirement, so the agent can choose the right approach."}],["$","$L2f",null,{}]]}]}]]}],["$","section",null,{"className":"section-block","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-no","children":"02"}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"THE IDEA BEHIND THE LAYER"}],["$","h2",null,{"children":"How the production proposal differs from this trial"}]]}]]}],["$","$L17",null,{"children":["$","$L18",null,{"id":"production-cycles","title":"Read the full playbook cycle and the POC’s simplifications","summary":"Preparing guidance, owner approval, repeated use and later maintenance.","children":[["$","p",null,{"className":"section-intro section-intro-wide","children":"Before agents can use the interpretation layer, it needs to build an initial understanding of the system. It examines the code, documentation and recorded decisions, then drafts guidance explaining which rules apply and why. In production, that guidance is checked and sent to the responsible owner for approval."}],["$","p",null,{"className":"section-intro section-intro-wide","children":"Once approved, the guidance can help agents with many coding tasks. They consult the relevant rules when planning a change and check their work against them as they proceed. The layer does not reconstruct the rules each time a new task begins."}],["$","p",null,{"className":"section-intro section-intro-wide","children":"The guidance also needs to stay current. Changes to the system may reveal a new rule, an exception or a reason to revise existing guidance. Those findings go through review before the guidance changes."}],["$","p",null,{"className":"section-intro section-intro-wide","children":"Our POC tests the initial preparation and repeated use of guidance. It has no project owner to approve the rules, and it keeps the guidance unchanged during each comparison. Ongoing maintenance is outside this pilot."}],"$L30"]}]}],"$L31","$L32","$L33"]}],"$L34","$L35","$L36","$L37"]
44:I["1c4abca9d553",[],"RepositoryCards",1]
20:["$","p",null,{"children":"Asking a model whether it recognises a project is not enough. We will look for signs of recall when choosing the project and its tasks. The two checks below ask for details the model has not been given."}]
21:["$","ol",null,{"className":"plain-list","children":[["$","li",null,{"children":[["$","strong",null,{"children":"When screening repositories:"}]," give the model a short excerpt with a distinctive detail removed, such as unusual comment wording or an arbitrary test value. Ask it to recover the missing detail. Include comparable, newly written snippets to see how often it can guess without prior exposure."]}],["$","li",null,{"children":[["$","strong",null,{"children":"When selecting historical tasks:"}]," give the model a limited task description, with no repository access, and ask where and how it would make the change. Compare the answer with distinctive details of the historical fix that were not supplied in the prompt."]}]]}]
22:["$","p",null,{"children":"A conventional correct solution could come from reasoning. Reproducing unusual details is more suggestive of recall. Neither test can prove that the model has never seen the material."}]
23:["$","p",null,{"children":"We will set the questions, scoring rules and number of attempts before running these checks. We will use the exact model versions intended for the experiment."}]
24:["$","p",null,{"children":"Each check runs in a separate session. The model can read only the supplied excerpt or task description, with no browsing or additional file access. Its questions and answers will stay out of the later experimental agents’ histories."}]
25:["$","p",null,{"children":"We will run these checks when choosing repositories and tasks, rather than during every coding attempt. We will revisit them if the model version or selected material changes."}]
26:["$","p",null,{"children":"The report will keep all outcomes, including unsuccessful attempts. It will say “familiarity detected” or “not detected by these probes”. It will never describe a lack of detected recall as proof that the material was unfamiliar."}]
27:["$","p",null,{"children":"Evidence of familiarity will inform whether we use a repository and how we interpret its results. It will not automatically exclude the repository. We will record the selection decision and its reason."}]
28:["$","p",null,{"children":["The test of missing details adapts ",["$","a",null,{"className":"text-link","href":"https://arxiv.org/abs/2311.09783","target":"_blank","rel":"noreferrer","children":"research on recovering omitted benchmark details"}],". It still needs a protocol suited to these repositories. Removing project names is an optional diagnostic, not proof that code is unfamiliar."]}]
29:["$","$L18",null,{"id":"phase-budget","title":"How will we limit the work and cost?","children":[["$","p",null,{"children":"Before model calls, agree a spending ceiling and limits for drafting, verification, revisions and assessment. Use separate development material for any authorised calibration. Fix the scored run settings before opening its results."}],["$","p",null,{"children":"Keep failed preparation and exhausted attempts in the report. The matched budgets for coding comparisons apply in Phases 2 and 3. Phase 1 records preparation costs but cannot calculate savings from code changes it has not tested."}]]}]
2a:["$","$L18",null,{"id":"phase-one-production","title":"How does this differ from production?","children":[["$","p",null,{"children":"Production would ask a responsible owner to approve or revise the proposed rules. No project owner is available for this POC. We can test whether claims are supported by public evidence, but cannot certify an owner’s unrecorded intentions."}],["$","p",null,{"children":"Production would also keep guidance current and serve it during work. This phase assesses a fixed version. Later phases test its use; maintenance remains a possible separate study."}]]}]
2b:["$","$L18",null,{"id":"phase-one-examples","title":"See illustrative examples of the guidance","children":[["$","p",null,{"children":"NetBox is a public application for documenting network infrastructure. The examples below illustrate guidance about its change history and other project rules. They are shortened explanations, not the exact instructions or selected cases for this phase."}],["$","$L2f",null,{}]]}]
2c:["$","$L18",null,{"id":"use-costs","title":"Read how costs and reuse will be compared","children":[["$","p",null,{"children":"Preparing a guide costs time and money before it helps with any code change. We will measure whether savings from later uses recover that initial cost. The work must still meet the same quality requirements."}],["$","h3",null,{"children":"What the coding phases will record"}],["$","p",null,{"children":"For each guide, we will add its preparation cost to the cost of the tasks that use it. We will compare that total with the cost of doing those same tasks from the sources alone."}],["$","p",null,{"children":"Failed preparation, unfinished tasks and unnecessary reviews will stay in the totals. Counting only successful work would give a misleading picture of the cost."}],["$","div",null,{"className":"phase-later-note","children":["$","p",null,{"children":["Phases 2 and 3 will record actual costs and any reuse observed in their tasks. Detailed estimates about future savings belong to a later study. ",["$","a",null,{"className":"text-link","href":"/interpretation-layer-poc/#what-could-follow","children":"See what could follow the first trial."}]]}]}],["$","details",null,{"className":"economic-later","children":[["$","summary",null,{"children":"Why we are keeping the idea of cost recovery"}],["$","div",null,{"className":"economic-example","children":[["$","h4",null,{"children":"An illustration, not a POC result"}],["$","p",null,{"children":"Suppose preparing and verifying a guide costs £60. A satisfactory change costs £10 with sources alone and £7 with the guide. Both amounts include review and corrections."}],["$","p",null,{"children":"The guide saves £3 per change. If that saving continues, 20 applicable changes would recover the £60 spent on preparation. Savings would begin after that."}],["$","p",null,{"children":"If using the guide costs as much or more per change, further use would not recover its preparation cost. If quality gets worse, spending less does not by itself establish a useful return."}]]}],["$","p",null,{"children":"We will report whether the guide recovered its preparation cost during the experiment."}],["$","p",null,{"children":"A later study may estimate how many more changes would be needed. That estimate would explain its assumptions about future use and how uncertain the answer is. Where the evidence does not support a saving, it would say that the cost may never be recovered."}],["$","p",null,{"children":"Trying the same task several times tells us how consistent the results are. To find out whether the guide helps with other changes, we need to test it on different tasks."}]]}],["$","h3",null,{"children":"How the comparison stays fair"}],["$","p",null,{"children":"Each group gets the same total spending allowance. The groups using guidance pay for its preparation from that allowance, leaving the rest for coding, tools, questions and review."}],["$","p",null,{"children":"When several tasks can use the same guide, we divide its preparation cost equally across those tasks. We choose that set before the runs and keep unsuccessful tasks in it. We cannot add more tasks afterwards just to make preparation look cheaper."}],["$","p",null,{"children":"We compare each guidance group with the group using sources alone. We also compare the two guidance groups with each other. That shows whether the extra interaction improves the work enough to justify its cost."}],["$","p",null,{"children":"The experiment prepares their shared guide once. When comparing the methods, each carries the preparation cost it would incur if used on its own. The total study spending records that shared preparation only once."}],"$L38","$L39","$L3a","$L3b","$L3c"]}]
2d:["$","$L18",null,{"id":"use-budget","title":"Read how the spending allowance will be chosen","children":[["$","p",null,{"children":"First, we will agree how much the whole study can spend. That includes preparing the experiment, checking the assessment tools, running the trials and assessing their results."}],["$","p",null,{"children":"We will then try the groups included in that phase on a few separate development tasks: two groups in Phase 2, and all three in Phase 3. These tasks will help us understand what preparation, coding, questions, review and corrections actually cost. They will stay out of the independent tests used to support our final conclusions."}],["$","p",null,{"children":"Before those trials, we will record how their results will guide the budget choice. We want each method to have enough room to make a serious attempt and complete the required reviews. We will not choose the amount that happens to make the layer look best. The exact amounts and selection criteria still need to be agreed."}],["$","p",null,{"children":"For any method using a guide, preparation uses part of that allowance. We will fix both its spending limit and the tasks sharing that cost before the comparison."}],["$","p",null,{"children":"Once calibration is complete, we will fix the allowance before the scored comparison begins. An agent that runs out of budget stops, and its unfinished work remains part of the results."}],["$","p",null,{"children":"Each coding comparison will use an allowance fixed for that phase and matched across its groups. A second budget level belongs to a later study if it is justified and funded. For now, conclusions about cost will apply only to the allowance and tasks actually tested."}],["$","p",null,{"children":["$","a",null,{"className":"text-link","href":"/interpretation-layer-poc/progress/#technical-status","children":"See Progress & findings for the calibration status and decisions still to make."}]}]]}]
2e:["$","p",null,{"className":"phase-handoff","children":"The next phase asks a different question: once the agent has a guide, does consultation and checking during work add anything further?"}]
30:["$","div",null,{"className":"guidance-cycles","id":"guidance-cycles","children":[["$","section",null,{"className":"guidance-cycle","aria-labelledby":"preparation-cycle-title","children":[["$","span",null,{"className":"eyebrow","children":"DRAFTING & APPROVAL CYCLE"}],["$","h3",null,{"id":"preparation-cycle-title","children":"Establish and maintain the guidance"}],["$","ol",null,{"className":"cycle-steps","children":[["$","li",null,{"children":[["$","h4",null,{"children":"Find the evidence"}],["$","p",null,{"children":"Read the relevant code, documentation and recorded decisions, including exceptions and conflicting examples."}]]}],["$","li",null,{"children":[["$","h4",null,{"children":"Draft and verify the guidance"}],["$","p",null,{"children":"Explain where each proposed rule applies and what evidence supports it. Check for contradictions before sending it for owner review."}]]}],["$","li",null,{"children":[["$","h4",null,{"children":"Review and release a version"}],["$","p",null,{"children":"In production, the responsible owner approves the proposed guidance, rejects it or asks for changes. Only approved decisions are released as authoritative guidance."}]]}]]}],["$","p",null,{"className":"cycle-repeat","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8","key":"v9h5vc"}],["path",{"d":"M21 3v5h-5","key":"1q7to0"}],["path",{"d":"M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16","key":"3uifl3"}],["path",{"d":"M8 16H3v5","key":"1cv678"}]],"className":"lucide-refresh-cw","size":17,"aria-hidden":"true"}],["$","span",null,{"children":"Review can send a draft back for revision before a version is released."}]]}],["$","p",null,{"className":"cycle-timing","children":[["$","strong",null,{"children":"In this POC:"}]," there is no responsible project owner. The verifier checks whether the evidence supports each claim, and accepted claims form the guide. This does not make them rules approved by an owner. The guide is prepared before the coding tasks and stays unchanged during their comparison."]}]]}],["$","div",null,{"className":"guidance-connection","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M5 12h14","key":"1ays0h"}],["path",{"d":"m12 5 7 7-7 7","key":"xquz4c"}]],"className":"lucide-arrow-right guidance-connection-arrow","size":28,"aria-hidden":"true"}],["$","strong",null,{"children":"A released guidance version"}],["$","p",null,{"children":"The guide explains where each rule applies and includes its evidence and exceptions. Production adds owner approval. This POC checks the evidence."}],["$","span",null,{"children":"The same version can support many tasks."}]]}],["$","section",null,{"className":"guidance-cycle guidance-cycle-use","aria-labelledby":"usage-cycle-title","children":[["$","span",null,{"className":"eyebrow","children":"USAGE CYCLE"}],["$","h3",null,{"id":"usage-cycle-title","children":"Apply the guidance to each task"}],["$","ol",null,{"className":"cycle-steps","children":[["$","li",null,{"children":[["$","h4",null,{"children":"Consult and plan"}],["$","p",null,{"children":"Retrieve the relevant guidance. Identify what can be reused, what constrains the change and which exceptions may apply."}]]}],["$","li",null,{"children":[["$","h4",null,{"children":"Check the plan"}],["$","p",null,{"children":"Review the proposed approach against the guidance and resolve blocking issues before editing."}]]}],["$","li",null,{"children":[["$","h4",null,{"children":"Implement and check during work"}],["$","p",null,{"children":"The agent can ask further questions. At defined checkpoints and when the approach changes, the checker reviews the work so far and can require an explanation or correction before it continues."}]]}],["$","li",null,{"children":[["$","h4",null,{"children":"Check the resulting work"}],["$","p",null,{"children":"Assess the change against the relevant decisions and task requirements. Record objections and unresolved questions."}]]}]]}],["$","p",null,{"className":"cycle-repeat","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":"$30:props:children:0:props:children:3:props:children:0:props:iconNode","className":"lucide-refresh-cw","size":17,"aria-hidden":"true"}],["$","span",null,{"children":"Objections can send the plan or code back for revision, or stop the attempt."}]]}],"$L3d"]}],"$L3e"]}]
31:["$","div",null,{"className":"scope-note","id":"pilot-scope","children":[["$","span",null,{"children":"What this POC can test"}],["$","div",null,{"children":[["$","p",null,{"children":"The coding phases select changes previously made in one public project. Each selected task needs requirements supported by project records and tests that can be repeated. This lets the technical steps be examined without asking maintainers to approve new rules or take part in each run."}],["$","p",null,{"children":[["$","strong",null,{"children":"Prior familiarity remains a limitation."}]," A model may already know the public code. Using the same models, tasks and budgets makes the methods comparable, but cannot prove that an agent worked out a rule solely from the files it received. Separate familiarity checks will look for recalled project details and historical fixes before the pilot."]}],["$","p",null,{"children":"The results will concern the technical steps. They cannot show that a project owner approves the guidance or that a maintenance process keeps it current. Later iterations could involve project owners and examine maintenance if these are needed to answer the remaining questions."}],["$","p",null,{"children":"The diagram above describes the full proposal. This pilot prepares a guide for a defined code version and set of permitted sources, then reuses it across the associated tasks. It is not one guide for every repository or historical version. Results from final evaluation cannot be used to repair it during that comparison."}]]}]]}]
32:["$","$L17",null,{"children":["$","$L18",null,{"id":"production-scope","title":"Where does this POC differ from production?","summary":"Owner approval, repeated use, maintenance and the way success is measured.","children":[["$","p",null,{"children":"The experiment tests a limited part of the production proposal. It checks whether guidance has evidence behind it and helps with historical tasks. No project owner certifies that guidance. Guidance remains fixed during each comparison, so the pilot does not test whether updates keep it correct over time."}],["$","p",null,{"children":"Production would apply the layer to current engineering work. This POC repeats tasks under two conditions in Phase 2 and three in Phase 3. Each comparison controls the inputs and review rules, then assesses the results independently. These controls help us compare the methods fairly. A production team would choose a workflow suited to its own work."}],["$","p",null,{"children":"The first trial uses a public project and may encounter knowledge a model already has. Familiarity probes can find signs of recall, but cannot certify that a project is unseen. The coding phases record the cost of reusing a fixed guide, not the full economics of a production service."}],["$","p",null,{"children":["The relevant sections below explain each difference where it affects this trial. Broader studies have their own place on the roadmap. ",["$","a",null,{"className":"text-link","href":"/interpretation-layer-poc/progress/","children":"Progress & findings"}]," shows which parts are built or tested."]}]]}]}]
33:["$","p",null,{"className":"caption","children":["In both coding phases, every group receives review. The ",["$","a",null,{"className":"text-link","href":"#during-work","children":"detailed method"}]," explains the checks before editing, during implementation and at final submission."]}]
34:["$","section",null,{"className":"section-block","id":"comparison","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-no","children":"03"}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"THE PROPOSED COMPARISON"}],["$","h2",null,{"children":"Separate the value of guidance from the value of checking its use"}]]}]]}],["$","p",null,{"className":"section-intro","children":"Phase 2 compares the first two groups. Phase 3 compares all three together after adding and qualifying the interactive checker."}],["$","p",null,{"className":"section-intro","children":"The table below explains what help each group receives. Every preparation result remains in its declared comparison, including an empty guide and the cost of producing it."}],["$","div",null,{"className":"comparison comparison-three","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"WITHOUT THE EXTRA LAYER"}],["$","h3",null,{"children":"Sources only"}],["$","p",null,{"children":"It searches the code and available documentation, works out what matters for the task, and makes the change. This represents a capable agent doing the work directly."}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"WITH PREPARED GUIDANCE"}],["$","h3",null,{"children":"Sources and prepared guidance"}],["$","p",null,{"children":"The layer has examined the same sources and written guidance before the task begins. The agent receives that guidance and works with it, with ordinary review but without the layer’s structured questions."}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"WITH GUIDANCE AND INTERACTION"}],["$","h3",null,{"children":"Sources, prepared guidance and interaction"}],["$","p",null,{"children":"The agent receives the same guidance, consults the layer about its plan and responds to checks at agreed points. The run records whether those interactions prevent mistakes or add unnecessary work."}]]}]]}],["$","div",null,{"className":"review-comparison","id":"review-comparison","children":[["$","h3",null,{"children":"Every group gets a review"}],["$","p",null,{"children":"Every group has its plan reviewed before editing, receives checks during work and submits its final code for review. The rules for when a review is required and how many corrections are allowed are the same for all three."}],["$","p",null,{"children":"Different approaches may trigger different numbers of checks during implementation. For example, a substantial change of plan requires another review."}],["$","p",null,{"children":"The groups differ in the help available throughout planning, implementation and review. The table shows how that difference applies to the reviewer:"}],["$","table",null,{"className":"review-comparison-table","children":[["$","caption",null,{"className":"sr-only","children":"What the reviewer checks in each group"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Group"}],["$","th",null,{"scope":"col","children":"What the reviewer checks"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Sources only"}],["$","td",null,{"children":"The plan and code against the available sources, including any applicable AGENTS.md instructions present at the starting revision."}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Sources and prepared guidance"}],["$","td",null,{"children":"The reviewer checks the plan and code against the sources and the prepared guidance."}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Sources, prepared guidance and interaction"}],["$","td",null,{"children":"The reviewer has the same sources and guide. The layer also asks the agent which rules apply and how its proposed action follows them. An agent claiming an exception must explain why it is justified."}]]}]]}]]}],"$L3f","$L40","$L41"]}],"$L42","$L43"]}]
35:["$","section",null,{"className":"section-block","id":"method","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-no","children":"04"}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"THE EXPERIMENT, STEP BY STEP"}],["$","h2",null,{"children":"The coding comparison in Phases 2 and 3"}]]}]]}],["$","p",null,{"className":"section-intro","children":"This is the detailed procedure for the later coding phases. Phase 2 uses the first two groups; Phase 3 runs all three together. The sequence starts before guidance preparation because we must choose its intended tasks before seeing what the guide contains."}],["$","ol",null,{"className":"method-steps","aria-label":"The four steps in one experiment","children":[["$","li",null,{"className":"method-step","children":[["$","div",null,{"className":"method-step-heading","children":[["$","span",null,{"className":"method-step-number","aria-hidden":"true","children":"1"}],["$","h3",null,{"children":"Choose a task and establish how to judge the result"}]]}],["$","div",null,{"className":"method-step-content","children":[["$","p",null,{"children":"Each test will ask an agent to repeat a real change from a project’s history. Before the agent starts, the case record must explain what that change needed to achieve and which project rules applied at the time. Those rules need supporting evidence. A pattern repeated in code is not automatically a requirement. The original solution and the assessment of it stay hidden from the agent."}],["$","$L17",null,{"children":["$","$L18",null,{"id":"choose-case","title":"How are tasks selected and assessment criteria established?","children":[["$","p",null,{"children":"We inspected one version of each repository to find potential test cases. For a selected task, we will return to the code as it stood before the original change. That may be a different version from the one initially inspected."}],["$","p",null,{"children":"The task requirements and project rules must also belong to that time. Later documentation cannot introduce an obligation that the original developer did not have."}],["$","p",null,{"children":[["$","strong",null,{"children":"Start with the evidence."}]," Each case uses a published requirement or decision. Its scope is checked against the code, and any disagreement is recorded. Neither the documentation nor the implementation is assumed to be correct."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Check that the assessment can tell the difference."}]," Each case includes:"]}],["$","ul",null,{"className":"plain-list","children":[["$","li",null,{"children":"A valid solution."}],["$","li",null,{"children":"A deliberately incorrect change."}],["$","li",null,{"children":"A legitimate exception or alternative."}]]}],["$","p",null,{"children":"The tests and source evidence must show why the valid solutions are acceptable and the incorrect change is not. A second valid solution can provide the alternative. We will not invent an exception just to complete the list."}],["$","p",null,{"children":"If the evidence cannot settle an important requirement, the case stays out of the scored comparison. Other uncertainties remain recorded. Passing a few tests is not enough if they miss behaviour that matters to the task."}],["$","p",null,{"children":[["$","strong",null,{"children":"Keep the coverage in perspective."}]," The existing candidate pool covers NetBox, Wagtail, Paperless-ngx and HTTPX. The first trial will select one of them and a small set of distinct decision families. Screening four repositories does not commit the trial to running all four."]}],["$","$L44",null,{}]]}]}]]}]]}],["$","li",null,{"className":"method-step","children":[["$","div",null,{"className":"method-step-heading","children":[["$","span",null,{"className":"method-step-number","aria-hidden":"true","children":"2"}],"$L45"]}],"$L46"]}],"$L47","$L48"]}],"$L49","$L4a"]}]
36:["$","section",null,{"className":"section-block","id":"technical-setup","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-no","children":"05"}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"TECHNICAL SETUP"}],["$","h2",null,{"children":"How the components work together"}]]}]]}],["$","p",null,{"className":"section-intro","children":"The experiment runner is a program that coordinates the work. It gives each agent the files it may read and passes permitted questions and review decisions between them."}],["$","p",null,{"className":"section-intro","children":"The runner also controls when code can execute and records what happened. Each agent has a separate working environment. The runner controls the connections between those environments."}],["$","p",null,{"className":"section-intro","children":"The proposed setup runs tools and code inside a virtual machine, or VM. A container inside that VM places further restrictions on the work. The AI models themselves run at the provider, in separate sessions managed by the runner."}],["$","aside",null,{"className":"production-difference","aria-label":"Production and this POC","children":[["$","div",null,{"children":[["$","h4",null,{"children":"In production"}],["$","p",null,{"children":"A deployed layer would need controlled access to current project systems, organisational permissions and approved guidance. The exact integrations and isolation design would depend on that environment."}]]}],["$","div",null,{"children":[["$","h4",null,{"children":"In this POC"}],["$","p",null,{"children":"The proposed runner uses isolated roles, an offline VM and containers, restricted file transfers and hidden assessment records to control this experiment. Separate model sessions keep probe and evaluation material out of coding attempts."}]]}],["$","p",null,{"className":"production-limit","children":"The selected research setup is not a production deployment recommendation. Passing its boundary tests would establish only the protections actually tested, not general safety or readiness for organisational use."}]]}],["$","p",null,{"className":"section-intro","children":"This is the proposed setup for the complete coding trial. Phase 1 starts with controlled reading for the drafter, verifier and guidance assessor. It does not need the coding agents or interactive checker. If a tool is allowed to execute code during source inspection, the relevant execution protections must be tested before that tool is enabled."}],[["$","section",null,{"className":"runtime-process","id":"runtime-process","aria-labelledby":"runtime-process-title","children":[["$","h3",null,{"id":"runtime-process-title","children":"The process before the machinery"}],["$","p",null,{"children":"The experiment has two connected activities: preparing guidance and using it on engineering tasks. Independent assessment examines the resulting work separately. The experiment runner coordinates these activities and enforces their boundaries."}],["$","div",null,{"className":"runtime-process-stage","children":[["$","span",null,{"className":"eyebrow","children":"PREPARATION · BEFORE TASK WORK"}],["$","h4",null,{"children":"Prepare and freeze the guidance"}],["$","p",null,{"children":"The runner gives the drafter the project evidence it is allowed to read. A separate verifier checks the proposed claims. The accepted claims form a saved version of the guide."}],["$","p",null,{"children":"This checks the evidence behind the claims. It does not supply approval from a project owner."}],["$","p",null,{"children":"The two groups using guidance receive that same saved guide for the tasks assigned to it. The group using sources alone receives the permitted project files and instructions."}]]}],"$L4b","$L4c"]}],"$L4d"],"$L4e","$L4f","$L50","$L51","$L52"]}]
37:["$","details",null,{"className":"after-trial","id":"what-could-follow","children":[["$","summary",null,{"children":"What could follow the first trial?"}],["$","p",null,{"children":"If the first trial justifies it, a separate confirmation study would freeze the method and use fresh cases that did not shape it. Broader repositories, models, production approval and maintenance remain possible later studies."}]]}]
38:["$","h3",null,{"children":"What else will the cost report show?"}]
39:["$","p",null,{"children":"Money, human effort and elapsed time will be reported separately."}]
3a:["$","p",null,{"children":"Preparing test cases, checking familiarity and independently scoring results also cost resources. Those are research costs, so we will report them separately from the cost of using each method. Prices, quality requirements and the tasks sharing a guide must be recorded before the relevant runs."}]
3b:["$","p",null,{"children":"The comparison uses the same coding model, tools, code version and ordinary review settings across groups. Each attempt starts with a separate history and workspace. We will vary the order of the groups so that one method does not always run first. Ordinary reviewers can still ask useful questions."}]
3c:["$","aside",null,{"className":"production-difference","aria-label":"Production and this POC","children":[["$","div",null,{"children":[["$","h4",null,{"children":"In production"}],["$","p",null,{"children":"A live system would also need to account for maintaining guidance, its use by a team, and any defensible value from avoided mistakes. A human could review costs and outcomes before deciding how guidance should change."}]]}],["$","div",null,{"children":[["$","h4",null,{"children":"In this POC"}],["$","p",null,{"children":"Phase 1 records preparation costs. The coding phases add the cost of use across their selected tasks. The guide stays unchanged. Detailed estimates of future return and a dashboard for managing rules belong to later work."}]]}],["$","p",null,{"className":"production-limit","children":"These results could show when a tested guide recovers its cost. They would not establish the full return for an organisation. Where several rules help with the same change, we will assess their combined value unless the evidence supports attributing it to individual rules."}]]}]
3d:["$","p",null,{"className":"cycle-timing","children":[["$","strong",null,{"children":"In this POC:"}]," all groups receive review at the required checkpoints. The interactive group also receives structured questions about the guidance. If the task needs a decision that the evidence cannot settle, the attempt stops. No project owner is available to answer it. These are planned checks, not continuous monitoring of every action."]}]
3e:["$","div",null,{"className":"guidance-feedback","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 20v-7a4 4 0 0 0-4-4H4","key":"1nkjon"}],["path",{"d":"M9 14 4 9l5-5","key":"102s5s"}]],"className":"lucide-corner-up-left","size":21,"aria-hidden":"true"}],["$","p",null,{"children":[["$","strong",null,{"children":"New evidence can prompt a guidance review."}]," Work may expose an outdated rule, a conflict or an unrecorded exception. In production, that evidence goes back for review. It cannot change an approved decision by itself. Reviews could run nightly, with earlier review of consequential changes. That cadence is a proposal. This POC records the issue but keeps the guide unchanged."]}]]}]
3f:["$","p",null,{"children":"This comparison tests whether the extra questions improve the result when ordinary review and guidance are already available."}]
40:["$","p",null,{"children":"Each group gets the same total spending allowance. For the group using sources alone, it pays for coding, tools and review. For the two groups using guidance, it also pays for drafting and verifying the guide. That leaves less to spend on the task itself."}]
41:["$","p",null,{"children":"When several tasks reuse the same guide, its preparation cost is shared across those tasks. We choose that task set before preparing its guide. We keep failed tasks in the set and retain their share of preparation cost."}]
42:["$","aside",null,{"className":"production-difference","aria-label":"Production and this POC","children":[["$","div",null,{"children":[["$","h4",null,{"children":"In production"}],["$","p",null,{"children":"A team would use the level of assistance and review appropriate to its work. There would be no need to repeat every change three ways."}]]}],["$","div",null,{"children":[["$","h4",null,{"children":"In this POC"}],["$","p",null,{"children":"Phase 2 compares sources alone with prepared guidance. Phase 3 runs those groups again alongside guidance plus interaction. Each comparison uses the same review rules and total spending limits."}]]}],["$","p",null,{"className":"production-limit","children":"This tests the selected procedures under controlled conditions. It does not establish how teams would adopt them or which review policy suits every organisation."}]]}]
43:["$","$L17",null,{"children":[["$","$L18",null,{"id":"fair-comparison","title":"What does the layer cost, and when could it pay for itself?","children":[["$","p",null,{"children":"Preparing a guide costs time and money before it helps with any code change. We will measure whether savings from later uses recover that initial cost. The work must still meet the same quality requirements."}],["$","h3",null,{"children":"What the coding phases will record"}],["$","p",null,{"children":"For each guide, we will add its preparation cost to the cost of the tasks that use it. We will compare that total with the cost of doing those same tasks from the sources alone."}],["$","p",null,{"children":"Failed preparation, unfinished tasks and unnecessary reviews will stay in the totals. Counting only successful work would give a misleading picture of the cost."}],["$","div",null,{"className":"phase-later-note","children":["$","p",null,{"children":["Phases 2 and 3 will record actual costs and any reuse observed in their tasks. Detailed estimates about future savings belong to a later study. ",["$","a",null,{"className":"text-link","href":"/interpretation-layer-poc/#what-could-follow","children":"See what could follow the first trial."}]]}]}],["$","details",null,{"className":"economic-later","children":[["$","summary",null,{"children":"Why we are keeping the idea of cost recovery"}],["$","div",null,{"className":"economic-example","children":[["$","h4",null,{"children":"An illustration, not a POC result"}],["$","p",null,{"children":"Suppose preparing and verifying a guide costs £60. A satisfactory change costs £10 with sources alone and £7 with the guide. Both amounts include review and corrections."}],["$","p",null,{"children":"The guide saves £3 per change. If that saving continues, 20 applicable changes would recover the £60 spent on preparation. Savings would begin after that."}],["$","p",null,{"children":"If using the guide costs as much or more per change, further use would not recover its preparation cost. If quality gets worse, spending less does not by itself establish a useful return."}]]}],["$","p",null,{"children":"We will report whether the guide recovered its preparation cost during the experiment."}],["$","p",null,{"children":"A later study may estimate how many more changes would be needed. That estimate would explain its assumptions about future use and how uncertain the answer is. Where the evidence does not support a saving, it would say that the cost may never be recovered."}],["$","p",null,{"children":"Trying the same task several times tells us how consistent the results are. To find out whether the guide helps with other changes, we need to test it on different tasks."}]]}],["$","h3",null,{"children":"How the comparison stays fair"}],["$","p",null,{"children":"Each group gets the same total spending allowance. The groups using guidance pay for its preparation from that allowance, leaving the rest for coding, tools, questions and review."}],["$","p",null,{"children":"When several tasks can use the same guide, we divide its preparation cost equally across those tasks. We choose that set before the runs and keep unsuccessful tasks in it. We cannot add more tasks afterwards just to make preparation look cheaper."}],["$","p",null,{"children":"We compare each guidance group with the group using sources alone. We also compare the two guidance groups with each other. That shows whether the extra interaction improves the work enough to justify its cost."}],["$","p",null,{"children":"The experiment prepares their shared guide once. When comparing the methods, each carries the preparation cost it would incur if used on its own. The total study spending records that shared preparation only once."}],"$L53","$L54","$L55","$L56","$L57"]}],"$L58"]}]
45:["$","h3",null,{"children":"Prepare and verify guidance before the coding tasks begin"}]
46:["$","div",null,{"className":"method-step-content","children":[["$","p",null,{"children":"The interpretation layer’s drafter examines the project files it is allowed to read and proposes guidance. A separate verifier checks whether the evidence supports each claim."}],["$","p",null,{"children":"Neither receives the later coding tasks. The investigator chooses the intended tasks first. We save the verifier’s guide before showing those tasks to the coding agents, then reuse it for the recorded comparisons. The drafter does not start again for every agent attempt."}],["$","p",null,{"children":"The guide belongs to a specific code version and set of permitted sources. Different repositories, historical versions or conditions for source access may need different guides. We choose the files the drafter may read without using the hidden solution to guide that choice. Otherwise, even the selection of files could give away the answer."}],["$","aside",null,{"className":"production-difference","aria-label":"Production and this POC","children":[["$","div",null,{"children":[["$","h4",null,{"children":"In production"}],["$","p",null,{"children":"An initial review would reconstruct candidate rules from the existing system. After verification and owner approval, agents would reuse the released guidance. Later reviews would examine changed evidence, new exceptions and possible new rules."}]]}],["$","div",null,{"children":[["$","h4",null,{"children":"In this POC"}],["$","p",null,{"children":"The drafter and verifier prepare a fixed guidance version for its declared tasks. The verifier’s acceptance means that a claim has evidence support; it is not owner approval. The guide stays unchanged while those tasks are compared."}]]}],["$","p",null,{"className":"production-limit","children":"The pilot can examine preparation and repeated use. It cannot show that nightly reviews or another maintenance schedule keep production guidance up to date."}]]}],["$","$L17",null,{"children":[["$","$L18",null,{"id":"allowed-evidence","title":"Does the layer read the documentation, or work the rule out from code?","children":[["$","p",null,{"children":"We want to distinguish reading a rule in documentation from working it out through code. The experiment therefore uses two sets of permitted inputs. A model may already know the project in either case."}],["$","p",null,{"children":[" Each project’s actual ",["$","code",null,{"children":"AGENTS.md"}]," files, including applicable instructions for the relevant directories, are supplied from the starting revision to every group in the comparison. If those instructions state a tested rule, the case is classified as using documented guidance. Missing files are recorded as absent."]}],["$","ul",null,{"className":"plain-list","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Code without a disclosed rule."}]," Eligible cases do not state the target rule in their applicable AGENTS.md instructions. Other written material that gives away the rule is withheld from every group in this test. The same restrictions apply to each group. The layer uses the remaining code evidence, or acknowledges that the rule cannot be established. If a policy is hidden and the code offers no way to work it out, we cannot expect the agent to discover it. We can test whether the layer recognises that it does not have enough evidence."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Using documentation."}]," The declared documents are available. The assessment checks whether the layer understands their scope, preserves exceptions and notices disagreements with the code."]}]]}],"$L59","$L5a","$L5b","$L5c","$L5d","$L5e"]}],"$L5f","$L60"]}]]}]
47:["$","li",null,{"className":"method-step","children":[["$","div",null,{"className":"method-step-heading","children":[["$","span",null,{"className":"method-step-number","aria-hidden":"true","children":"3"}],["$","h3",null,{"children":"Run the same task three ways"}]]}],["$","div",null,{"className":"method-step-content","children":[["$","p",null,{"children":"Separate agent attempts receive the same task and the same allowed project sources. What changes is the help they receive:"}],["$","ul",null,{"className":"method-groups","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Sources only."}]," The agent works out what matters from the code and available documentation."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Sources and prepared guidance."}]," The agent also receives the guide prepared in step 2."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Sources, prepared guidance and interaction."}]," The agent receives that same guide and consults the layer about its plan and actions."]}]]}],["$","p",null,{"className":"caption","children":"The technical plan calls these groups DIRECT, GUIDE and INTERACT, in the same order."}],["$","p",null,{"children":"All three groups get ordinary review and opportunities to correct mistakes. The interactive group also receives targeted questions about how it applies the rules. The rules that trigger review and correction limits are the same across groups, and all reviewing counts towards the agreed budget."}],["$","$L17",null,{"children":["$","$L18",null,{"id":"during-work","title":"What does the checker do while the agent works?","children":[["$","p",null,{"children":[["$","strong",null,{"children":"Before the first edit,"}]," the interactive agent consults the layer and submits a plan. It explains what it will reuse, what it will change and which rules or exceptions apply. A separate checker assesses whether those proposed actions follow the evidence."]}],["$","p",null,{"children":[["$","strong",null,{"children":"During implementation,"}]," the runner checks incoming code submissions against the approved plan. At the configured review points, and whenever a material change of approach is detected, it pauses further work and sends the plan and changes to the checker. The checker assesses the applicable rules and exceptions while the task is still in progress, so a blocking issue can be corrected before work continues."]}],["$","p",null,{"children":[["$","strong",null,{"children":"After a check,"}]," the agent receives “proceed”, “revise” or “unresolved”, with a reason. The proposed limit is two correction rounds at each required review point. If the task needs a decision that remains unresolved, the attempt stops. It also stops if the agent cannot satisfy the check within the correction allowance."]}],["$","p",null,{"children":"Uncertainty unrelated to completing the task is recorded without blocking valid work. Unfinished work still goes to assessment."}],["$","p",null,{"children":[["$","strong",null,{"children":"If the approach changes,"}]," a new dependency, a different component to reuse or a new claimed exception requires an updated plan. Tests must establish that the runner catches undeclared changes too. These checks during work are triggered by submissions and detected changes; the checkpoint schedule and limits are defined before the run."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Before completion,"}]," every group submits its final code for review, with the same correction allowance. After completion or a stop, the code goes to independent evaluation and receives no further correction opportunity from that evaluator."]}],["$","p",null,{"children":"The checker can see the task, plan, changes and permitted evidence. It cannot see the hidden assessment answers or the coding agent’s private reasoning."}],"$L61","$L62","$L63"]}]}]]}]]}]
48:["$","li",null,{"className":"method-step","children":[["$","div",null,{"className":"method-step-heading","children":[["$","span",null,{"className":"method-step-number","aria-hidden":"true","children":"4"}],["$","h3",null,{"children":"Assess the work and record its cost"}]]}],["$","div",null,{"className":"method-step-content","children":[["$","p",null,{"children":"A separate evaluator assesses both the historical implementation and the agent’s change using the same criteria prepared in step 1:"}],["$","ul",null,{"className":"plain-list","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Task correctness:"}]," does the implementation deliver the required behaviour?"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Guardrail compliance:"}]," does it follow the applicable project rules, including legitimate exceptions? Those rules must have supporting evidence."]}]]}],["$","p",null,{"children":"If the historical code violates a guardrail and the agent avoids that violation while completing the task correctly, the agent receives credit for the improvement. A different valid solution is not penalised for differing from the original. Points and weighting are fixed before scored runs."}],["$","p",null,{"children":"The assessment is prepared from project evidence before the runs. It cannot impose a later policy or turn a repeated coding pattern into a mandatory rule without justification."}],["$","p",null,{"children":"The layer’s generated guidance is checked against that evidence too. A rule proposed by the layer cannot become a scoring requirement merely because the layer proposed it."}],["$","p",null,{"children":"We also record whether reviews raised unnecessary objections, whether the task was finished and what the work cost."}],["$","p",null,{"children":"An agent refusing the task, returning an invalid response or leaving work unfinished is an outcome of the method. A genuine failure of the surrounding infrastructure is recorded separately. The rules for handling failures and retries are fixed before the runs."}],["$","aside",null,{"className":"production-difference","aria-label":"Production and this POC","children":[["$","div",null,{"children":[["$","h4",null,{"children":"In production"}],["$","p",null,{"children":"A team would assess whether changes meet its requirements and whether the layer helps its work over time. Operational review and maintenance decisions would involve the responsible people."}]]}],["$","div",null,{"children":[["$","h4",null,{"children":"In this POC"}],["$","p",null,{"children":"After an attempt ends, separate assessors examine the saved guidance, code and review decisions against prepared evidence. Historical code is assessed by the same criteria and may itself be wrong. Hidden final scores do not return to the working agent."}]]}],["$","p",null,{"className":"production-limit","children":"This independent assessment is part of the research design. It does not replace production accountability or demonstrate a working organisational approval process."}]]}],["$","p",null,{"children":"The first comparison tests whether prepared guidance helps. Comparing the two groups that receive guidance tests whether interaction adds a further benefit."}],["$","$L17",null,{"children":[["$","$L18",null,{"id":"reliable-judge","title":"How will the assessments be shown to be reliable?","children":[["$","p",null,{"children":"We test each component before the phase that uses it. Phase 1 needs the verifier and independent guidance assessor. Phase 2 adds code assessment; Phase 3 adds the interactive checker and assessment of its decisions. During work, the verifier decides which claims can enter the guide, and reviewers decide whether the agent may continue."}],"$L64","$L65","$L66","$L67","$L68","$L69","$L6a","$L6b"]}],"$L6c"]}]]}]]}]
49:["$","div",null,{"className":"method-preparation","children":[["$","h3",null,{"children":"When the coding comparison is complete"}],["$","p",null,{"children":"The trial must leave an inspectable record of its inputs, guidance, work, reviews, failures and costs. The report will explain which controls worked within their tested scope and what remains uncertain."}],["$","p",null,{"children":"We then decide whether to proceed, repair the procedure, narrow the question or stop. A favourable result is not required. Independent confirmation after the three phases is a separate decision, using fresh cases."}],["$","a",null,{"className":"text-link","href":"/interpretation-layer-poc/progress/","children":["See preparation, decisions and results ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$30:props:children:1:props:children:0:props:iconNode","className":"lucide-arrow-right","size":16}]]}]]}]
4a:["$","p",null,{"className":"caption","children":["The ",["$","a",null,{"className":"text-link","href":"/interpretation-layer-poc/evidence/working-poc-plan.md","download":true,"children":"working experiment plan"}]," records the full method and design decisions. The ",["$","a",null,{"className":"text-link","href":"/interpretation-layer-poc/progress/#evidence","children":"evidence record and case library"}]," are on Progress & findings."]}]
4b:["$","div",null,{"className":"runtime-process-stage","children":[["$","span",null,{"className":"eyebrow","children":"TASK USE · REPEATED FOR EACH COMPARISON GROUP"}],["$","h4",null,{"children":"Plan, review and carry out the change"}],["$","p",null,{"children":"Each attempt starts in a separate model session. The coding agent submits a plan for review."}],["$","p",null,{"children":"Once the reviewer permits work, the runner starts a limited batch of tools or code in an isolated environment. It collects the results and closes that environment before deciding what may happen next."}],["$","p",null,{"children":"The work returns to review at the required checkpoints and when the approach changes substantially. The group with interaction also receives questions about how it applies the guidance. All groups follow the same review rules and resource limits."}],["$","p",null,{"children":"The cycle repeats until the attempt finishes or a stop rule ends it. Each role retains only its permitted history and files. The guide stays frozen during task use; it is not redrafted after each tool batch."}]]}]
4c:["$","div",null,{"className":"runtime-process-stage","children":[["$","span",null,{"className":"eyebrow","children":"INDEPENDENT ASSESSMENT · OUTSIDE THE LIVE TASK CYCLE"}],["$","h4",null,{"children":"Assess the work and preserve the record"}],["$","p",null,{"children":"After an attempt ends, separate assessors examine its code and review decisions. The saved guide is also assessed independently of the verifier that accepted it."}],["$","p",null,{"children":"The code assessment asks whether the task was completed correctly and whether the applicable project rules were followed. It uses the same criteria for the agent’s code and the original historical implementation. Hidden assessment feedback does not return to the working agents."}],["$","p",null,{"children":"The runner preserves outcomes and costs, including failed and unfinished attempts. All three methods for a matched task and repeat are run on the same machine. Its private records must be retained and verified. Moving experimental execution to another machine is deferred until it is needed and that host is qualified."}]]}]
4d:["$","figure",null,{"className":"execution-tree","id":"execution-tree","aria-labelledby":"execution-tree-title execution-tree-caption","children":[["$","h3",null,{"id":"execution-tree-title","children":"Where the containers run"}],["$","pre",null,{"children":"Windows laptop or home PC\n├─ Experiment runner\n│  └─ Python controller\n└─ VirtualBox\n   └─ Ubuntu VM (offline)\n      └─ Podman container\n         └─ Tools or code"}],["$","figcaption",null,{"id":"execution-tree-caption","children":[["$","p",null,{"children":"One worker container runs inside one virtual machine at a time. Each tool batch gets a fresh environment. Assessment code runs in a separate fresh environment."}],["$","p",null,{"children":"The AI models run at the provider. The runner on Windows manages their separate sessions. The diagram below shows which connections are permitted."}]]}]]}]
4e:["$","figure",null,{"className":"runtime-diagram","id":"runtime-architecture","aria-labelledby":"runtime-diagram-title runtime-diagram-caption","children":[["$","div",null,{"className":"runtime-heading","children":[["$","span",null,{"className":"eyebrow","children":"PROPOSED DEPLOYMENT"}],["$","h3",null,{"id":"runtime-diagram-title","children":"Where each part runs"}]]}],["$","div",null,{"className":"runtime-models","children":[["$","h4",null,{"children":"Model provider · separate context for every role"}],["$","div",null,{"className":"runtime-role-groups","children":[["$","div",null,{"children":[["$","span",null,{"children":"Preparation"}],["$","p",null,{"children":[["$","b",null,{"children":"Drafter"}],["$","b",null,{"children":"Verifier"}]]}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Task work"}],["$","p",null,{"children":[["$","b",null,{"children":"Coder"}],["$","b",null,{"children":"Reviewer / checker"}]]}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Independent assessment"}],["$","p",null,{"children":[["$","b",null,{"children":"Guidance assessor"}],["$","b",null,{"children":"Code judge"}],["$","b",null,{"children":"Intervention assessor"}]]}]]}]]}],["$","p",null,{"className":"runtime-note","children":"Each outlined role has its own history and permitted inputs. No shared memory, tool sessions or direct connections between roles. Provider and models remain to be selected."}]]}],["$","div",null,{"className":"runtime-api","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m21 16-4 4-4-4","key":"f6ql7i"}],["path",{"d":"M17 20V4","key":"1ejh1v"}],["path",{"d":"m3 8 4-4 4 4","key":"11wl7u"}],["path",{"d":"M7 4v16","key":"1glfcx"}]],"className":"lucide-arrow-up-down","aria-hidden":"true"}],["$","span",null,{"children":[["$","strong",null,{"children":"Model connection controlled by the runner"}],["$","br",null,{}],"Permitted messages and tool requests; credentials stay on Windows."]}]]}],["$","div",null,{"className":"runtime-host","children":[["$","h4",null,{"children":["Selected Windows machine ",["$","span",null,{"children":"Sized for the 32 GB laptop · one worker VM at a time"}]]}],["$","div",null,{"className":"runtime-execution","children":[["$","div",null,{"className":"runtime-controller","children":[["$","span",null,{"className":"eyebrow","children":"TRUSTED CONTROL"}],["$","h5",null,{"children":"Experiment runner: Python controller"}],["$","p",null,{"children":[["$","strong",null,{"children":"CPython 3.12 · asyncio + subprocess"}],["$","br",null,{}],"Coordinates when work starts, pauses for review or stops. The amount of custom code is still under review."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Pydantic 2 + explicit checks"}],["$","br",null,{}],"Check who sent each record, what it contains and whether it is allowed at this stage."]}],["$","p",null,{"children":[["$","strong",null,{"children":"pywin32"}],["$","br",null,{}],"Receive serial results through a restricted Windows named pipe."]}],["$","div",null,{"className":"runtime-private","children":[["$","strong",null,{"children":"Separate local data areas"}],["$","br",null,{}],"Separate areas hold each role’s history and allowed files, returned results, and assessment records hidden from working agents. The runner selects permitted files; no whole store enters a VM."]}]]}],["$","div",null,{"className":"runtime-transfers","aria-label":"Permitted controller and guest transfers","children":[["$","div",null,{"children":[["$","span",null,{"children":[["$","strong",null,{"children":"Input"}],["$","br",null,{}],"pycdlib",["$","br",null,{}],"ISO mounted for reading only"]}],["$","$Ld",null,{"ref":"$undefined","iconNode":"$30:props:children:1:props:children:0:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","div",null,{"children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","aria-hidden":"true"}],["$","span",null,{"children":[["$","strong",null,{"children":"Output"}],["$","br",null,{}],"Virtual serial port",["$","br",null,{}],"JSON with a size limit"]}]]}],["$","div",null,{"children":[["$","span",null,{"children":[["$","strong",null,{"children":"Control"}],["$","br",null,{}],"VBoxManage",["$","br",null,{}],"Start / stop / discard"]}],["$","$Ld",null,{"ref":"$undefined","iconNode":"$30:props:children:1:props:children:0:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"runtime-vm","children":[["$","span",null,{"className":"eyebrow","children":"OUTER ISOLATION BOUNDARY"}],["$","h5",null,{"children":"Oracle VirtualBox 7.2"}],["$","p",null,{"children":["$L6d","$L6e","Python guest launcher owns the input disk and serial device."]}],"$L6f","$L70","$L71"]}]]}],"$L72"]}],"$L73","$L74"]}]
4f:["$","section",null,{"className":"technology-section","id":"tools-technologies","aria-labelledby":"tools-technologies-title","children":[["$","h3",null,{"id":"tools-technologies-title","children":"Tools and technologies"}],["$","p",null,{"children":["The experiment needs tools for coordination, model access, isolation, assessment and record keeping. The table names the products and libraries selected for the proposed implementation and identifies the remaining choices. The ",["$","a",null,{"className":"text-link","href":"/interpretation-layer-poc/progress/#technical-status","children":"H04 prototype’s implemented tools"}]," are documented on Progress & findings."]}],["$","table",null,{"className":"technology-table","children":[["$","caption",null,{"className":"sr-only","children":"Proposed technologies, their purpose and selection status"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Component"}],["$","th",null,{"scope":"col","children":"Technology and reason"}],["$","th",null,{"scope":"col","children":"Choice"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Experiment runner"}],["$","td",null,{"children":[["$","strong",null,{"children":"CPython 3.12: asyncio and subprocess."}]," These utilities can dispatch work and call VBoxManage. The extent of custom coordination code remains subject to the playbook tooling review."]}],["$","td",null,{"children":"Proposed; scope under review"}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Record validation"}],["$","td",null,{"children":[["$","strong",null,{"children":"Pydantic 2."}]," Strict schemas reject unknown fields and wrong types. Separate controller checks enforce byte limits, path permissions, role identity and state transitions."]}],["$","td",null,{"children":"Chosen for implementation"}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Virtual machine"}],["$","td",null,{"children":[["$","strong",null,{"children":"Oracle VirtualBox 7.2 with VBoxManage."}]," The controller creates a disposable clone, starts it and forcibly stops it when required. Host compatibility must be tested."]}],["$","td",null,{"children":"Chosen; compatibility gate"}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Guest system"}],["$","td",null,{"children":[["$","strong",null,{"children":"Ubuntu Server 24.04 LTS, amd64."}]," A minimal Linux guest holds the launcher and preinstalled dependencies. All VM network adapters are disabled during execution."]}],["$","td",null,{"children":"Chosen for implementation"}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Containers"}],["$","td",null,{"children":[["$","strong",null,{"children":"Rootless Podman with crun."}]," Linux cgroup v2 enforces resource limits; seccomp restricts system calls. Each tool batch has a private workspace, no network and no exposed runtime socket."]}],["$","td",null,{"children":"Chosen; enforcement to test"}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Input transfer"}],["$","td",null,{"children":[["$","strong",null,{"children":"pycdlib."}]," Python builds an ISO containing only the permitted job pack. VirtualBox attaches it as an optical disk that the guest can read but cannot change. No host folder is shared."]}],["$","td",null,{"children":"Chosen for implementation"}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Output transfer"}],["$","td",null,{"children":[["$","strong",null,{"children":"VirtualBox virtual serial port + pywin32."}]," A Windows named pipe carries bounded JSON results. pywin32 supplies Windows pipe and APIs for access controls; the controller treats every result as untrusted."]}],["$","td",null,{"children":"Chosen; transport to test"}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Agent access"}],["$","td",null,{"children":[["$","strong",null,{"children":"Separate role contexts through a controlled model gateway."}]," Assess LiteLLM / Portkey before deciding what custom gateway code is needed. Provider, model IDs and adapter remain open. Browsing supplied by the provider, execution and shared memory are excluded."]}],"$L75"]}],"$L76","$L77"]}]]}],"$L78","$L79","$L7a"]}]
50:["$","section",null,{"className":"technology-section","id":"containers-and-machines","aria-labelledby":"containers-and-machines-title","children":[["$","h3",null,{"id":"containers-and-machines-title","children":"Run on one qualified machine"}],["$","p",null,{"children":"The coding phases will run on one qualified Windows machine. The proposed setup is sized to fit the 32 GB laptop. Editing the project from either machine can continue through GitHub without moving experimental execution between them."}],["$","ul",null,{"className":"plain-list","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Separate the agents."}]," Each role has its own model context, permitted input pack and tool workspace. The controller passes only authorised submissions and review messages. Shared memory, retrieval stores and direct connections between agents are excluded; assessment answers stay outside working roles."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Prepare a clean environment."}]," Install pinned dependencies before execution, then disable the VM’s network adapters. The containers run tools and generated code; the Windows controller makes model calls through a separate gateway."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Limit every transfer."}]," Supply permitted files on a disk image that the guest cannot change. Collect bounded results through a virtual serial connection checked by the controller. This interface is part of the boundary that must be tested."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Reset between tool batches."}]," Each bounded batch uses a fresh VM and container. Only checked workspace files carry forward. Execution stops before the next review, and environments share no writable caches."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Keep each comparison on the selected host."}]," Run all three groups on that machine and retain protected records. If experiments later move to another host, it must first pass the same required tests and receive verified records. That transfer capability is not a gate for the first trial."]}]]}],["$","p",null,{"children":["The ",["$","a",null,{"className":"text-link","href":"https://github.com/yspbob/interpretation-layer-poc/blob/main/research/development/isolated-runner-design-v0.1.md","target":"_blank","rel":"noreferrer","children":"detailed runner design"}]," specifies the container restrictions, transfer limits, provisional resource profile, failure handling and workflow for private records. Compatibility and containment must be demonstrated on any host before experiments run there. Each phase needs a qualified boundary for the capabilities it actually uses."]}]]}]
51:["$","$L17",null,{"children":[["$","$L18",null,{"id":"technical-inputs","title":"What does each role receive?","children":[["$","p",null,{"children":"An input pack contains the files a role is allowed to read. Its manifest lists those files and their digital fingerprints, called hashes. The runner uses these to check that the contents have not changed before starting a fresh session."}],["$","ul",null,{"className":"plain-list","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Drafter and verifier:"}]," the permitted project evidence and instructions. The verifier also receives the proposed claims. Neither receives the later change task or final assessment."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Coder and reviewer:"}]," the task, permitted sources and applicable project instructions. The groups with prepared guidance also receive the same saved guide. Reviewers receive the submitted plan and changes; they do not receive the coder’s private reasoning."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Assessment roles:"}]," a guidance assessor checks the frozen guide against separately prepared evidence; an intervention assessor checks review decisions against what was knowable at the time. These records stay outside the live roles."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Final code judge:"}]," the code to assess, task requirements, guardrail criteria and independently produced test observations. The judge is not told whether the code came from a historical change or an agent, which comparison group produced it, or which model was used."]}]]}],["$","p",null,{"children":["The project’s actual ",["$","code",null,{"children":"AGENTS.md"}]," files, including applicable instructions for the relevant directories, are taken from the backtest’s starting revision. The same applicable files are supplied across all three groups. Their absence is recorded rather than filled with invented instructions. If they state a tested rule, that case is classified as using documented guidance."]}]]}],["$","$L18",null,{"id":"technical-execution","title":"How are plans, reviews and model calls coordinated?","children":[["$","p",null,{"children":"The runner records whether an attempt is waiting for a plan, a review or a correction, is allowed to work, or has stopped. It accepts only messages permitted at that stage."}],["$","p",null,{"children":"A substantial change of approach sends the attempt back to plan review. A required decision that cannot be settled, an exhausted allowance or a failed access boundary triggers the specified stop procedure."}],["$","p",null,{"children":"During implementation, incoming code submissions are checked against the approved plan. The runner pauses at configured review points and on detected material changes, then passes the relevant plan and code to the reviewer. Work resumes only after the required decision permits it. The same rules that trigger review and correction limits apply across all three groups. Different approaches can trigger different checks. While review is pending, the runner must block new coding turns and tools that would change files or state."}],["$","p",null,{"children":"A model gateway is the part that sends authorised requests to the model provider and records usage. Credentials stay outside the agent workspace."}],["$","p",null,{"children":"The controller passes only permitted questions, submissions and decisions between roles. An agent cannot use that connection to issue arbitrary commands."}],["$","p",null,{"children":"The gateway accepts requests only for approved model providers and enforces message size limits. It cannot fetch arbitrary websites. A correctly formatted message still needs its permissions and content checked."}],"$L7b"]}],"$L7c","$L7d"]}]
52:["$","p",null,{"className":"caption","children":["The method defines the required behaviour. ",["$","a",null,{"className":"text-link","href":"/interpretation-layer-poc/progress/#technical-status","children":"Progress & findings records component readiness and open technical choices."}]]}]
53:["$","h3",null,{"children":"What else will the cost report show?"}]
54:["$","p",null,{"children":"Money, human effort and elapsed time will be reported separately."}]
55:["$","p",null,{"children":"Preparing test cases, checking familiarity and independently scoring results also cost resources. Those are research costs, so we will report them separately from the cost of using each method. Prices, quality requirements and the tasks sharing a guide must be recorded before the relevant runs."}]
56:["$","p",null,{"children":"The comparison uses the same coding model, tools, code version and ordinary review settings across groups. Each attempt starts with a separate history and workspace. We will vary the order of the groups so that one method does not always run first. Ordinary reviewers can still ask useful questions."}]
57:["$","aside",null,{"className":"production-difference","aria-label":"Production and this POC","children":[["$","div",null,{"children":[["$","h4",null,{"children":"In production"}],["$","p",null,{"children":"A live system would also need to account for maintaining guidance, its use by a team, and any defensible value from avoided mistakes. A human could review costs and outcomes before deciding how guidance should change."}]]}],["$","div",null,{"children":[["$","h4",null,{"children":"In this POC"}],["$","p",null,{"children":"Phase 1 records preparation costs. The coding phases add the cost of use across their selected tasks. The guide stays unchanged. Detailed estimates of future return and a dashboard for managing rules belong to later work."}]]}],["$","p",null,{"className":"production-limit","children":"These results could show when a tested guide recovers its cost. They would not establish the full return for an organisation. Where several rules help with the same change, we will assess their combined value unless the evidence supports attributing it to individual rules."}]]}]
58:["$","$L18",null,{"id":"budget-selection","title":"How will we choose the spending allowance?","summary":"Development tasks help us choose an allowance before the scored comparison.","children":[["$","p",null,{"children":"First, we will agree how much the whole study can spend. That includes preparing the experiment, checking the assessment tools, running the trials and assessing their results."}],["$","p",null,{"children":"We will then try the groups included in that phase on a few separate development tasks: two groups in Phase 2, and all three in Phase 3. These tasks will help us understand what preparation, coding, questions, review and corrections actually cost. They will stay out of the independent tests used to support our final conclusions."}],["$","p",null,{"children":"Before those trials, we will record how their results will guide the budget choice. We want each method to have enough room to make a serious attempt and complete the required reviews. We will not choose the amount that happens to make the layer look best. The exact amounts and selection criteria still need to be agreed."}],["$","p",null,{"children":"For any method using a guide, preparation uses part of that allowance. We will fix both its spending limit and the tasks sharing that cost before the comparison."}],["$","p",null,{"children":"Once calibration is complete, we will fix the allowance before the scored comparison begins. An agent that runs out of budget stops, and its unfinished work remains part of the results."}],["$","p",null,{"children":"Each coding comparison will use an allowance fixed for that phase and matched across its groups. A second budget level belongs to a later study if it is justified and funded. For now, conclusions about cost will apply only to the allowance and tasks actually tested."}],["$","p",null,{"children":["$","a",null,{"className":"text-link","href":"/interpretation-layer-poc/progress/#technical-status","children":"See Progress & findings for the calibration status and decisions still to make."}]}]]}]
59:["$","p",null,{"children":"Each claim must say where it came from. A rule copied from a guide will not be reported as a rule inferred from code. The verifier uses only the material allowed in that test; it cannot consult the hidden assessment to repair the guide."}]
5a:["$","p",null,{"children":"Only claims accepted by the verifier enter the guide. Preparation stops when its budget or allowed revisions are exhausted. The guidance group in Phase 2 receives that result. In Phase 3, both guidance groups receive the same result. If no claims were accepted, the guide is empty."}]
5b:["$","p",null,{"children":"We retain that outcome and its cost. We do not select only guides that scored well in the independent assessment. Missing or incorrect guidance is part of what the experiment needs to measure."}]
5c:["$","p",null,{"children":"We may stop or improve the method between phases. If we change it, we record the new version and prepare fresh guidance where needed. We cannot present selected successes from the old version as evidence of the whole method’s reliability."}]
5d:["$","p",null,{"children":"After the guide is saved, a separate assessor checks its quality. That assessment asks whether its claims are supported, where they came from and whether important requirements are missing. The verifier cannot provide the independent verdict on its own work."}]
5e:["$","p",null,{"children":"The website’s examples are illustrations. The actual guidance supplied to an experimental agent will be prepared under this procedure."}]
5f:["$","$L18",null,{"id":"familiarity-checks","title":"Can the model already recall the project or the historical fix?","children":[["$","h3",null,{"children":"What the agent learns during our study"}],["$","p",null,{"children":"An agent is meant to read the code assigned to its task. It can remember that evidence while it works. What it must not inherit is another attempt’s history, our research notes or the hidden answers."}],["$","p",null,{"children":"Each independent attempt starts with a fresh conversation and workspace. Only its assigned inputs are carried in, including the prepared guide for groups that receive one. The drafter’s conversation and assessment feedback stay out."}],["$","p",null,{"children":"Calling a session incognito would not prove that separation. We must check the actual history, files, memory and tool access. These controls are required but have not yet been implemented or tested."}],["$","p",null,{"children":"Provider training and storage settings need a separate check when we choose the experimental interface. A fresh session cannot erase knowledge already learned during model training."}],["$","h3",null,{"children":"What the model may have known beforehand"}],["$","p",null,{"children":"Asking a model whether it recognises a project is not enough. We will look for signs of recall when choosing the project and its tasks. The two checks below ask for details the model has not been given."}],["$","ol",null,{"className":"plain-list","children":[["$","li",null,{"children":[["$","strong",null,{"children":"When screening repositories:"}]," give the model a short excerpt with a distinctive detail removed, such as unusual comment wording or an arbitrary test value. Ask it to recover the missing detail. Include comparable, newly written snippets to see how often it can guess without prior exposure."]}],["$","li",null,{"children":[["$","strong",null,{"children":"When selecting historical tasks:"}]," give the model a limited task description, with no repository access, and ask where and how it would make the change. Compare the answer with distinctive details of the historical fix that were not supplied in the prompt."]}]]}],["$","p",null,{"children":"A conventional correct solution could come from reasoning. Reproducing unusual details is more suggestive of recall. Neither test can prove that the model has never seen the material."}],["$","p",null,{"children":"We will set the questions, scoring rules and number of attempts before running these checks. We will use the exact model versions intended for the experiment."}],["$","p",null,{"children":"Each check runs in a separate session. The model can read only the supplied excerpt or task description, with no browsing or additional file access. Its questions and answers will stay out of the later experimental agents’ histories."}],["$","p",null,{"children":"We will run these checks when choosing repositories and tasks, rather than during every coding attempt. We will revisit them if the model version or selected material changes."}],["$","p",null,{"children":"The report will keep all outcomes, including unsuccessful attempts. It will say “familiarity detected” or “not detected by these probes”. It will never describe a lack of detected recall as proof that the material was unfamiliar."}],["$","p",null,{"children":"Evidence of familiarity will inform whether we use a repository and how we interpret its results. It will not automatically exclude the repository. We will record the selection decision and its reason."}],"$L7e"]}]
60:["$","$L18",null,{"id":"isolation","title":"How is withheld assessment material kept out of the inputs?","children":[["$","p",null,{"children":["Each agent receives only its assigned files and history. A new independent attempt starts separately, with no access to previous attempts, shared memory or our research notes. Historical solutions and assessment answers stay out of the coding and review environments. The ",["$","a",null,{"className":"text-link","href":"#technical-setup","children":"technical setup"}]," explains the execution boundaries and permitted communication routes."]}],["$","p",null,{"children":"The input audit must also look for disclosures in comments, tests, examples and dependencies. Removing the obvious guide does not establish that its contents have been withheld."}],["$","p",null,{"children":"Public code may already be familiar to a model from training. The first pilot therefore makes a limited claim: it compares whether prepared guidance and structured checking help on tasks from public projects whose requirements have supporting evidence. It does not establish that a model inferred the rule entirely from the supplied code. Using matched models, tasks and budgets does not remove this limitation."}],["$","p",null,{"children":"Private variants that change the correct rule are a possible later extension, not a prerequisite for the first pilot. Writing the change and tests ourselves, or obtaining another AI’s agreement, would not by itself validate the case. Such a variant needs a meaningful requirement, a consistent implementation and independently justified assessment evidence. Ambiguous variants remain development material. Harmless renaming can check robustness, but cannot establish that the original project was unfamiliar."}]]}]
61:["$","p",null,{"children":"The checker cannot rewrite the saved guidance. If it finds that the guide conflicts with the sources, it can explain the conflict and ask the agent to change its proposed action. The defect in the guide stays in the record."}]
62:["$","p",null,{"children":"Questions needing an owner’s authority remain unresolved. We cannot settle them by supplying an unrecorded human answer during a run."}]
63:["$","p",null,{"children":"Reviewers in the other groups can still identify mistakes and request corrections. They use their group’s sources and, where supplied, guidance. The intended difference is the structured consultation and targeted questions, not the mere presence of a reviewer. Instructions and budgets are specified and tested before runs."}]
64:["$","p",null,{"children":"Afterwards, separate assessors judge the saved guide, final code and review decisions. The verifier cannot provide the independent verdict on its own work."}]
65:["$","p",null,{"children":"Each component must be tested on the kind of decision it will make. Its test must give it only the information it will receive in that role. The procedure is:"}]
66:["$","ol",null,{"className":"plain-list","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Develop the instructions."}]," Use examples whose expected assessments are supported by project requirements, documented rules and reproducible tests. The historical implementation may itself contain mistakes. It is evidence to examine, rather than the definition of a correct answer."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Set the pass criteria in advance."}]," Decide the acceptable error rates and how much validation evidence is needed before seeing the results."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Test on fresh cases."}]," Freeze the instructions, then test them on different kinds of project decisions. Examples used to improve the judge cannot also prove its reliability."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Measure its mistakes."}]," Count incorrect work it accepts and correct work it rejects separately. Check that it accepts valid exceptions and recognises insufficient evidence. Repeat grading and vary presentation to see whether irrelevant differences change its verdict."]}]]}]
67:["$","p",null,{"children":"The code judge does not see group labels, model names or the generated guide. A separate assessment checks whether review objections were justified by the evidence available at the time. Review transcripts may reveal the group, so that assessment is not fully blinded."}]
68:["$","p",null,{"children":"The expected verdict must be justified by tests that can be repeated or by clear project evidence. Where that is not enough, independent expertise is needed. Agreement between two AI models is not enough. If the evidence cannot settle a judgement, it remains unresolved."}]
69:["$","p",null,{"children":"We will audit scores during the pilot. If an assessor or its criteria change, it must pass validation again. Every affected implementation must then be scored under the revised criteria."}]
6a:["$","p",null,{"children":"If a result from the main trial helps us repair the assessment, it becomes development evidence. We will need fresh cases to test the revised method independently."}]
6b:["$","p",null,{"children":["Section 9A of the ",["$","a",null,{"className":"text-link","href":"/interpretation-layer-poc/evidence/working-poc-plan.md","download":true,"children":"working plan"}]," contains the full qualification procedure."]}]
6c:["$","$L18",null,{"id":"interpret-results","title":"What conclusions would the comparison support?","children":[["$","p",null,{"children":"To justify the layer, its guidance must have evidence behind it, help with later work and be worth the cost. We assess the guidance itself as well as the code. A successful code change could otherwise conceal unsupported rules in the guide."}],["$","p",null,{"children":"We will also run a small, separate check that gives the agent a known correct rule directly. This asks whether the task could benefit from good guidance at all."}],["$","p",null,{"children":"For the first pilot, agents will repeat real changes previously made in the selected projects. Each task must first pass the checks on its requirements, evidence and assessment."}],["$","p",null,{"children":"Authored development examples and any independently justified later variants are reported separately, as are tests with and without the relevant documentation. A task that states the target rule can test its application, but not the benefit of discovering it."}],["$","p",null,{"children":"Several tasks may test the same underlying decision. The analysis must account for that relationship rather than count every variation or repeated attempt as independent evidence. The first trial will report these relationships and the variation it observes. A separate confirmation study would use that evidence to set a justified sample before its results are seen."}],["$","p",null,{"children":"A positive result would support using the layer for the kinds of public project tasks we tested. The model may already know some of that code, so we could not claim it discovered every rule from unfamiliar sources."}],["$","p",null,{"children":"The pilot also cannot establish that every organisation needs the layer, that an owner approves its rules or that a team would adopt it. Keeping guidance current across an organisation needs a later study."}],["$","p",null,{"children":"Negative and inconclusive results would also inform revisions to Chapter 4."}],["$","a",null,{"className":"text-link","href":"https://yspbob.github.io/AI-Playbook/AI_Engineering_Playbook.html#4-the-interpretation-layer","target":"_blank","rel":"noreferrer","children":["Read Chapter 4 in the public playbook ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1:1:props:children:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]
6d:["$","strong",null,{"children":"Ubuntu Server 24.04 LTS · amd64"}]
6e:["$","br",null,{}]
6f:["$","div",null,{"className":"runtime-container","children":[["$","span",null,{"className":"eyebrow","children":"INNER ISOLATION BOUNDARY"}],["$","h5",null,{"children":"Rootless Podman + crun"}],["$","p",null,{"children":["One role’s tools or submitted code.",["$","br",null,{}],"Image that cannot be changed. Private workspace with size limits."]}],["$","p",null,{"children":[["$","strong",null,{"children":"cgroup v2 · seccomp"}],["$","br",null,{}],"CPU, memory and process limits; restricted system calls."]}]]}]
70:["$","p",null,{"className":"runtime-denials","children":"No VM network adapters, shared host folders, clipboard, credentials or socket for controlling the container runtime."}]
71:["$","p",null,{"className":"runtime-note","children":"Fresh VM and container for each tool batch. Only validated files carry forward."}]
72:["$","div",null,{"className":"runtime-assessment","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 5v14","key":"s699le"}],["path",{"d":"m19 12-7 7-7-7","key":"1idqje"}]],"className":"lucide-arrow-down","aria-hidden":"true"}],["$","p",null,{"children":[["$","strong",null,{"children":"After the attempt stops:"}]," the runner supplies anonymised code and permitted evidence to separate assessment contexts. Evaluation code uses a fresh VM. Feedback from hidden tests and final scores do not return to working agents."]}]]}]
73:["$","div",null,{"className":"runtime-sync","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":"$4e:props:children:2:props:children:0:props:iconNode","className":"lucide-arrow-up-down","aria-hidden":"true"}],["$","p",null,{"children":[["$","strong",null,{"children":"Git for Windows + Git Credential Manager → GitHub"}],["$","br",null,{}],"Public repository: reviewed project files. Separate private repository: hidden case evidence, confidential results and a record of completed comparisons. Coding execution stays on one qualified host during the first trial. Editing can continue from either machine. Moving confidential runs later requires a verified save and a qualified destination."]}]]}]
74:["$","figcaption",null,{"id":"runtime-diagram-caption","children":"The boxes show where components run and what they may access. The arrows show permitted connections. Read the process above for the order of work. Only the runner on Windows connects to models and GitHub. The offline guest has no general route to either service. These controls require implementation and testing."}]
75:["$","td",null,{"children":"Provider and models to select"}]
76:["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Assessment"}],["$","td",null,{"children":[["$","strong",null,{"children":"Python behaviour checks and pinned project tests."}]," H04 uses HTTPX MockTransport and custom assertions. Python unittest is proposed for controller checks. Assess Promptfoo for evaluation execution and Langfuse for traces and cost records; model assessors still require separate qualification."]}],["$","td",null,{"children":"H04 checks exist; full suite to build"}]]}]
77:["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Records and credentials"}],["$","td",null,{"children":[["$","strong",null,{"children":"JSON, SHA-256, Git for Windows and Git Credential Manager."}]," The design uses a public GitHub repository and a separate private repository. Windows Credential Manager keeps Git credentials local; pywin32’s win32cred API will read separately stored model credentials."]}],["$","td",null,{"children":"Private repository and runner storage setup pending"}]]}]
78:["$","p",null,{"children":[["$","strong",null,{"children":"Tooling review:"}]," the ",["$","a",null,{"className":"text-link","href":"https://yspbob.github.io/AI-Playbook/AI_Engineering_Playbook.html#2-infrastructure-platform","target":"_blank","rel":"noreferrer","children":"playbook recommends existing products for common platform capabilities"}],". The design must compare its gateway, evaluation and tracing needs with those products and explain each adoption or departure. LiteLLM, Portkey, Promptfoo and Langfuse are candidates for that review. None has been adopted or installed for the runner. Python utilities may still handle the coordination specific to this experiment."]}]
79:["$","p",null,{"className":"caption","children":"The selected products still need installation and testing. We must first show that they work together and enforce the intended access restrictions."}]
7a:["$","p",null,{"className":"caption","children":"Before execution, we will record the exact software versions, saved environment identifiers and settings. Before qualifying a model for a role, we will also fix its settings. Each run record will include what is needed to reproduce it."}]
7b:["$","p",null,{"children":"Candidate code runs separately from the controller and the full assessment store. Common task checks may return permitted feedback during work. Final evaluation uses a separate assessment path after the attempt ends. The evaluator must test resistance to modified tests and forged success reports, rather than trust a candidate’s claim that its checks passed."}]
7c:["$","$L18",null,{"id":"technical-isolation","title":"How is access beyond the test environment restricted?","children":[["$","p",null,{"children":"The design requires agents to have no general access to the host machine, other runs or external services. The runner still needs narrowly defined routes to supply inputs, pass permitted review messages and collect outputs. Those interfaces are part of the isolation boundary and must be tested too."}],["$","ul",null,{"className":"plain-list","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Restrict and record communication."}]," Permitted exchanges pass through the external controller. Other routes must be blocked, including indirect communication through shared services."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Minimise and test exposed services."}]," Each agent receives only the tools, storage and network capabilities its task requires. Every exposed capability is reviewed for unintended access. The controller and gateway are trusted components whose versions, permissions and behaviour must also be tested. Installing dependencies before the run and preventing changes to them removes the need for a live package service during execution."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Protect the host and assessment."}]," Host files, credentials and administrative controls stay outside agent access. Workspaces and caches cannot provide shared writable channels. The controller, stop mechanism and assessment records remain protected from agent writes."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Test attempted boundary crossings."}]," Controlled probes check file access, communication between roles and runs, direct and indirect network access, and attempts to alter enforcement. The relevant checks are repeated after environment changes. Detected failures stop affected runs and preserve the evidence."]}]]}],["$","p",null,{"children":["The Hugging Face incident demonstrated how a shared package service could become an unintended message board and a route to the internet. It motivates reviewing all exposed services, not only package installation. ",["$","a",null,{"className":"text-link","href":"https://openai.com/index/hugging-face-incident-and-the-road-ahead/","target":"_blank","rel":"noreferrer","children":"OpenAI’s account"}]," and ",["$","a",null,{"className":"text-link","href":"https://huggingface.co/blog/agent-intrusion-technical-timeline","target":"_blank","rel":"noreferrer","children":"Hugging Face’s technical account"}]," describe the incident."]}],["$","p",null,{"children":"The runner must record its isolation boundaries and the results of tests that attempt to cross them. These tests establish protection against the routes examined, with remaining limitations stated. They cannot guarantee that escape is impossible."}],["$","p",null,{"children":[["$","strong",null,{"children":"Proposed implementation:"}]," VirtualBox provides the outer VM boundary, with rootless Podman containers inside an Ubuntu guest. Input images that cannot be changed and serial output with size limits replace shared folders and guest networking. The virtualisation software and the programs that transfer data could still contain vulnerabilities. Any claim about isolation must state which routes were tested and what remains uncertain."]}]]}]
7d:["$","$L18",null,{"id":"technical-records","title":"What makes a run inspectable and repeatable?","children":[["$","p",null,{"children":"Each run will record exactly what the agents received and returned. It will also record the software and model settings, tool activity, review decisions, corrections, stops and resource use."}],["$","p",null,{"children":"The controller keeps those records outside agent access. It saves confidential records to the separate private repository and verifies the save before work continues on the other machine. A failed save must be recorded, and work that depends on the missing evidence cannot continue."}],["$","p",null,{"children":"Returned files and messages are treated as untrusted. The runner checks their destination, size and order before accepting them. It also checks whether links or files inside an archive could reach beyond the allowed folder."}],["$","p",null,{"children":"The assessment reports task correctness separately from compliance with project rules. It records improvements over the historical code, new violations and questions the evidence cannot settle."}],["$","p",null,{"children":"Public reports exclude credentials and hidden assessment material. Models, budgets, scoring weights and acceptance limits are fixed before the relevant scored runs."}]]}]
7e:["$","p",null,{"children":["The test of missing details adapts ",["$","a",null,{"className":"text-link","href":"https://arxiv.org/abs/2311.09783","target":"_blank","rel":"noreferrer","children":"research on recovering omitted benchmark details"}],". It still needs a protocol suited to these repositories. Removing project names is an optional diagnostic, not proof that code is unfamiliar."]}]
