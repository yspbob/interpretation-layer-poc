","children":"PHASE 1"}],["$","span",null,{"children":"Reconstruct guidance"}],["$","a",null,{"href":"/interpretation-layer-poc/phases/","children":"See the later phases"}]]}],[["$","section",null,{"className":"intro","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"THE FIRST TRIAL / PHASE 1 OF 3"}],["$","h1",null,{"children":"Can we reconstruct the project’s rules?"}],["$","p",null,{"className":"lead","children":"First, ask the interpretation layer to turn project evidence into guidance. Then check whether that guidance is accurate, explains its limits and covers the decisions we expected it to find."}],"$Le","$Lf"]}],"$L10"]}],"$L11","$L12","$L13","$L14"]]}],"$L15"]
